import("//products/build/go/go_library.gni")

if (is_host) {
  go_library("codegen") {
    sources = [ "codegen.go" ]
    deps = [
      "//tools/fidl/fidlgen_hlcpp/coding_tables",
      "//tools/fidl/lib/fidlgen_cpp",
    ]
    embedsrcs = [
      "coding_tables.tmpl",
      "header.tmpl",
      "implementation.tmpl",
      "proxies_and_stubs_protocol.tmpl",
      "proxies_and_stubs_service.tmpl",
      "test_base.tmpl",
      "types_alias.tmpl",
      "types_bits.tmpl",
      "types_const.tmpl",
      "types_enum.tmpl",
      "types_protocol.tmpl",
      "types_struct.tmpl",
      "types_table.tmpl",
      "types_union.tmpl",
    ]
  }
}
