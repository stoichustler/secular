import("//products/build/bazel/bazel_host_tool.gni")
import("//products/build/go/go_binary.gni")
import("//products/build/go/go_library.gni")

if (is_host) {
  if (secular_boot_build) {
    go_library("fidl_api_summarize_main") {
      sources = [ "main.go" ]
      deps = [
        "//tools/fidl/lib/fidlgen",
        "//tools/fidl/lib/summarize:gopkg",
      ]
    }

    go_binary("fidl_api_summarize") {
      embed = [ ":fidl_api_summarize_main" ]
    }
  } else {
    bazel_host_tool("fidl_api_summarize") {
      bazel_target = ":fidl_api_summarize"
      bazel_output_path =
          "{{BAZEL_TARGET_OUT_DIR}}/fidl_api_summarize_/fidl_api_summarize"
      install_host_tool = true
    }
  }
}
