import("//products/build/rust/rustc_binary.gni")

rustc_test("runner_bin") {
  name = "runner_bin"
  output_dir = target_out_dir + "/test"
  edition = "2024"
  sources = [ "src/main.rs" ]
  source_root = "src/main.rs"
  deps = [
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//tools/fidl/example-tester:example_tester",
    "//tools/fidl/example-tester/example/fidl:test.exampletester_rust",
  ]
}
