import("//products/build/host.gni")
import("//products/build/rust/rustc_test.gni")

rustc_test("tests") {
  name = "cm_fidl_analyzer_tests"
  edition = "2024"
  testonly = true

  deps = [
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust",
    "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/sys/component_manager/lib/router_error",
    "//userspace/sys/lib/runtime_capabilities",

    # Depend on zx-status crate instead of zx so that this builds for host.
    "//sdk/rust/zx-status",
    "//userspace/sys/lib/capability_source",
    "//userspace/sys/lib/cm_config",
    "//userspace/sys/lib/cm_rust",
    "//userspace/sys/lib/cm_rust/testing",
    "//userspace/sys/lib/cm_types",
    "//userspace/sys/lib/component_id_index",
    "//userspace/sys/lib/config_encoder",
    "//userspace/sys/lib/moniker",
    "//userspace/sys/lib/routing",
    "//userspace/sys/lib/routing/testing:routing_test_helpers",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:maplit",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:thiserror",
    "//tools/lib/cm_fidl_analyzer",
  ]
  sources = [
    "src/availability.rs",
    "src/dictionary.rs",
    "src/lib.rs",
    "src/rights.rs",
    "src/routing.rs",
    "src/storage.rs",
    "src/storage_admin.rs",
  ]
}
