import("//products/build/components.gni")
import("//products/build/test.gni")

test("inspector") {
  output_name = "inspector-test"
  configs += [ "//products/build/config:all_source" ]
  sources = [ "print_debug_info.cc" ]

  deps = [
    "//sdk/lib/fdio",
    "//userspace/lib/debug:backtrace-request",
    "//zircon/system/ulib/inspector",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("inspector-test-pkg") {
  package_name = "inspector-test"
  deps = [ ":inspector" ]
}

group("tests") {
  testonly = true
  deps = [ ":inspector-test-pkg" ]
}
