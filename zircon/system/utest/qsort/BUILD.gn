import("//products/build/components.gni")
import("//products/build/test.gni")

test("qsort") {
  output_name = "qsort-test"
  sources = [ "qsort.c" ]
  deps = [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("qsort-test-pkg") {
  package_name = "qsort-test"
  deps = [ ":qsort" ]
}

group("tests") {
  testonly = true
  deps = [ ":qsort-test-pkg" ]
}
