import("//products/build/config/current_target_tuple.gni")
import("//products/build/config/sysroot.gni")
import("//products/build/cpp/library_headers.gni")
import("//products/build/rust/rustc_library.gni")
import("//zircon/kernel/kernel_bindgen_crate.gni")

library_headers("headers") {
  headers = [ "lib/object-constants.h" ]

  if (is_kernel) {
    public_deps = [ "//zircon/kernel/lib/libc:headers" ]
  }
}

source_set("object-constants") {
  public_deps = [ ":headers" ]
}

kernel_bindgen_crate("object-constants-rs") {
  headers = [ "include/lib/object-constants.h" ]
  cpp = true

  non_rust_deps = [ ":headers" ]

  notice_year = 2026

  var_allowlist = [ "k.*" ]

  expect_lints = [ "non_upper_case_globals" ]

  raw_lines = [ "#![no_std]" ]
}

group("tests") {
  testonly = true
  deps = [ ":object-constants-rs" ]
}

group("kernel-tests") {
  testonly = true
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
