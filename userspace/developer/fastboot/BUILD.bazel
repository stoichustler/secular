load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = [
        "src/command.rs",
        "src/lib.rs",
        "src/reply.rs",
        "src/test_transport.rs",
    ],
    crate_name = "fastboot",
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    target_compatible_with = HOST_OS_CONSTRAINTS,
    test_deps = [
        "//userspace/lib/fuchsia",
    ],
    visibility = [
        "//userspace/developer/ffx:__pkg__",
        "//userspace/developer/ffx/lib/discovery:__pkg__",
        "//userspace/developer/ffx/lib/fastboot:__pkg__",
        "//userspace/developer/ffx/lib/fastboot/interface:__pkg__",
        "//userspace/developer/ffx/lib/fastboot/transport/factory:__pkg__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//userspace/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:async-fs",
        "//third_party/rust_crates/vendor:chrono",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
    ],
)
