# Host-only leftovers still required by package-tool / product_bundle
# (GCS credentials). ffx, debug, forensics, adb, and the rest of the
# developer tree have been removed from Secular.

group("developer") {
  testonly = true
  deps = [ "lib" ]
}

group("tests") {
  testonly = true
  deps = [ "lib:tests" ]
}
