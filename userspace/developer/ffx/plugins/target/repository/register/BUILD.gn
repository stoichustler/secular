  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust_fdomain",
    "//sdk/fidl/fuchsia.pkg.rewrite:fuchsia.pkg.rewrite_rust_fdomain",
    "//sdk/rust/zx-types",
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/pkg:pkg_fdomain",
    "//userspace/developer/ffx/lib/ssh:lib",
    "//userspace/developer/ffx/lib/target:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/fuchsia-hyper",
    "//userspace/sys/lib/fidl-fuchsia-pkg-ext",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:http-body-util",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:schemars",
