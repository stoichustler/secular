import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_list") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target:lib",
    "//userspace/developer/ffx/lib/target/behavior:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/plugins/target/list/target_formatter",
    "//userspace/lib/analytics/rust:lib",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]
  test_deps = [
    "//userspace/developer/ffx/command:lib",
    "//userspace/developer/ffx/lib/addr:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
  ]

  args_sources = [ "src/args.rs" ]
  args_deps = [
    "//userspace/developer/ffx/core:lib",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:bitflags",
  ]

  sources = [ "src/lib.rs" ]
}

group("list") {
  public_deps = [ ":ffx_list" ]
}

group("tests") {
  testonly = true

  deps = [
    ":ffx_list_tests($host_toolchain)",
    "target_formatter:target_formatter_test($host_toolchain)",
  ]
}
