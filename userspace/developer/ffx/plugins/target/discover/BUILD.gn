import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_target_discover") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/addr:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:nix",
    "//third_party/rust_crates:notify",
    "//third_party/rust_crates:tokio",
  ]

  test_deps = [
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:mockall",
    "//third_party/rust_crates:tempfile",
  ]

  args_sources = [ "src/args.rs" ]
  args_deps = [
    "//userspace/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]

  sources = [ "src/lib.rs" ]
}

group("tests") {
  testonly = true
  deps = [ ":ffx_target_discover_tests" ]
}
