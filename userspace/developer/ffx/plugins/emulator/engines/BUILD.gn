import("//products/build/rust/rustc_library.gni")

if (is_host) {
  rustc_library("ffx_emulator_engines") {
    with_unit_tests = true
    edition = "2024"
    sources = [
      "src/arg_templates.rs",
      "src/lib.rs",
      "src/qemu_based/comms.rs",
      "src/qemu_based/crosvm/mod.rs",
      "src/qemu_based/femu/mod.rs",
      "src/qemu_based/gpt.rs",
      "src/qemu_based/mod.rs",
      "src/qemu_based/qemu/image_conversion.rs",
      "src/qemu_based/qemu/mod.rs",
      "src/serialization.rs",
      "src/show_output.rs",
    ]
    deps = [
      "//products/build/sdk/meta:rust",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/emulator_instance:lib",
      "//userspace/developer/ffx/lib/errors:lib",
      "//userspace/developer/ffx/lib/fho:lib",
      "//userspace/developer/ffx/lib/port_picker:lib",
      "//userspace/developer/ffx/lib/target:lib",
      "//userspace/developer/ffx/lib/uefi_disk:lib",
      "//userspace/developer/ffx/plugins/emulator/common:ffx_emulator_common",
      "//userspace/developer/ffx/plugins/emulator/configuration:ffx_emulator_config",
      "//userspace/lib/fuchsia-async",
      "//userspace/storage/lib/sparse/rust:lib",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-trait",
      "//third_party/rust_crates:handlebars",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:nix",
      "//third_party/rust_crates:png",
      "//third_party/rust_crates:rand",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:shared_child",
      "//third_party/rust_crates:tempfile",
    ]
    test_deps = [
      "//userspace/lib/fuchsia",
      "//third_party/rust_crates:async-trait",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:tempfile",
    ]
    inputs = [
      "test_data/unknown_engine_type_engine.json",
      "test_data/testkey_atx_psk.pem",
      "test_data/atx_metadata.bin",
      "test_data/screenshot_input.ppm",
      "test_data/screenshot_golden.png",

      "templates/emulator_flags.json.template",
      "templates/efi_flags.json.template",
    ]

    # Each test writes the fake tools which it then runs. When tests run at the
    # same time, the fork of one test's child can overlap the write of another
    # test's script, and the exec of that script then fails with ETXTBSY; so the
    # tests run one at a time.
    args = [ "--test-threads=1" ]
  }

  group("tests") {
    testonly = true
    deps = [ ":ffx_emulator_engines_test($host_toolchain)" ]
  }
}
