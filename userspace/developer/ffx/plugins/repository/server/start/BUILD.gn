    "//userspace/lib/assembly/product_bundle",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-url",
    "//userspace/sys/lib/fidl-fuchsia-pkg-ext",
    "//userspace/sys/pkg/lib/fuchsia-repo",
