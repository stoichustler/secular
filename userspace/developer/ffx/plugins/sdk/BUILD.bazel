load("//products/build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//userspace/developer/ffx/build:ffx_plugin.bzl", "ffx_plugin")
load("//userspace/developer/ffx/build:ffx_tool.bzl", "ffx_tool")

package(default_applicable_licenses = ["//:license"])

ffx_plugin(
    name = "ffx_sdk",
    srcs = ["src/lib.rs"],
    args_deps = [
        "//userspace/developer/ffx/core:lib",
        "//third_party/rust_crates/vendor:argh",
        "//third_party/rust_crates/vendor:camino",
    ],
    args_srcs = ["src/args.rs"],
    config_data = ["data/config.json"],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:async-trait",
    ],
    sdk_category = "not-yet-specified",
    version = "0.1.0",
    visibility = ["//userspace/developer/ffx:__subpackages__"],
    deps = [
        "//userspace/developer/ffx/config:lib",
        "//userspace/developer/ffx/lib/fho:lib",
        "//userspace/developer/ffx/lib/sdk:lib",
        "//userspace/developer/ffx/lib/writer:lib",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
    ],
)

ffx_tool(
    name = "ffx_sdk_tool",
    srcs = ["src/main.rs"],
    binary_name = "ffx-sdk",
    edition = "2024",
    deps = [
        ":ffx_sdk",
        "//userspace/developer/ffx/lib/fho:lib",
        "//userspace/lib/fuchsia-async",
    ],
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
host_rustc_test(
    name = "ffx_sdk_test",
    crate = ":ffx_sdk",
    visibility = ["//userspace/developer/ffx:__pkg__"],
    deps = [
        "//userspace/lib/fuchsia",
        "//third_party/rust_crates/vendor:regex",
    ],
)
