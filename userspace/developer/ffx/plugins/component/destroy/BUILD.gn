import("../../../build/ffx_plugin.gni")

ffx_plugin("ffx_component_destroy") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  deps = [
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//userspace/developer/ffx/command/error:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/plugins/component/common:ffx_component",
    "//userspace/sys/lib/cm_types",
    "//userspace/sys/lib/component_debug:component_debug_fdomain",
    "//userspace/sys/lib/moniker",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:schemars",
    "//third_party/rust_crates:serde",
  ]

  args_sources = [ "src/args.rs" ]
  args_deps = [
    "//userspace/developer/ffx/core:lib",
    "//third_party/rust_crates:argh",
  ]

  test_deps = [
    "//userspace/lib/fdomain/local",
    "//userspace/lib/fuchsia",
  ]

  sources = [ "src/lib.rs" ]
}

group("host_tests") {
  testonly = true
  deps = [ ":ffx_component_destroy_tests" ]
}
