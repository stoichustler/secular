import("//userspace/developer/ffx/build/ffx_plugin.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  ffx_plugin("ffx_forward") {
    version = "0.1.0"
    edition = "2024"
    args_sources = [ "src/args.rs" ]
    args_with_unit_tests = true
    with_unit_tests = true
    args_deps = [
      "//userspace/developer/ffx/core:lib",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:regex",
      "//third_party/rust_crates:schemars",
      "//third_party/rust_crates:serde",
    ]
    sources = [ "src/lib.rs" ]
    deps = [
      "//userspace/developer/ffx/lib/errors:lib",
      "//userspace/developer/ffx/lib/fho:lib",
      "//userspace/developer/ffx/lib/target/connector:lib",
      "//userspace/developer/ffx/lib/target/holders:lib",
      "//userspace/developer/ffx/lib/target_net:lib",
      "//userspace/developer/ffx/lib/writer:lib",
      "//userspace/developer/ffx/tools/speedtest/common:speedtest_fdomain",
      "//userspace/lib/fuchsia-async",
      "//third_party/rust_crates:async-trait",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:schemars",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:termion",
      "//third_party/rust_crates:tokio",
    ]
    args_test_deps = [
      "//userspace/connectivity/lib/net-declare",
      "//third_party/rust_crates:test-case",
    ]
    test_deps = [
      "//userspace/connectivity/lib/net-declare",
      "//userspace/developer/ffx/lib/target_net:testutil",
      "//userspace/lib/fdomain/local",
      "//userspace/lib/fuchsia",
      "//third_party/rust_crates:assert_matches",
      "//third_party/rust_crates:itertools",
      "//third_party/rust_crates:pretty_assertions",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:vte",
    ]
  }

  ffx_tool("ffx_forward_tool") {
    edition = "2024"
    output_name = "ffx-forward"
    deps = [
      ":ffx_forward",
      "//userspace/developer/ffx/lib/fho:lib",
      "//userspace/lib/fuchsia-async",
    ]
    sources = [ "src/main.rs" ]
  }
}

group("forward") {
  public_deps = [
    ":ffx_forward_tool",
    ":ffx_forward_tool_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_forward_tool_versioned" ]
}

group("tests") {
  testonly = true
  deps = [ ":ffx_forward_tests($host_toolchain)" ]
}
