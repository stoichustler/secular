import("//products/build/rust/rustc_library.gni")

rustc_library("ffx_profile_stacktrack_common") {
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
    "//sdk/fidl/fuchsia.memory.stacktrack.client:fuchsia.memory.stacktrack.client_rust_fdomain",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/rcs:lib",
    "//userspace/developer/ffx/lib/symbolize",
    "//userspace/lib/fdomain/client",
    "//userspace/performance/memory/stacktrack/lib/stacktrack_snapshot:stacktrack_snapshot_fdomain",
    "//userspace/sys/lib/cm_rust",
    "//userspace/sys/lib/component_debug:component_debug_fdomain",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:schemars",
    "//third_party/rust_crates:serde",
  ]

  test_deps = [
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:serde_json",
