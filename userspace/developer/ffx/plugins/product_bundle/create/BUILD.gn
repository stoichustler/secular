import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_product_bundle_create") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  args_sources = [ "src/args.rs" ]
  sources = [
    "src/assembly.rs",
    "src/lib.rs",
  ]

  args_deps = [
    "//userspace/developer/ffx/core:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:camino",
  ]

  deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/assembly/api",
    "//userspace/lib/assembly/artifact_cache",
    "//userspace/lib/assembly/assembled_system",
    "//userspace/lib/assembly/cli_args",
    "//userspace/lib/assembly/config_schema",
    "//userspace/lib/assembly/container",
    "//userspace/lib/assembly/product_bundle",
    "//userspace/lib/assembly/release_info",
    "//userspace/lib/assembly/tool",
    "//userspace/lib/assembly/util",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//userspace/storage/lib/delivery_blob",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:tempfile",
  ]

  test_deps = []
}
