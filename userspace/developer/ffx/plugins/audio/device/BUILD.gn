import("//userspace/developer/ffx/build/ffx_plugin.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

ffx_plugin("ffx_audio_device") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  args_with_unit_tests = true

  args_deps = [
    "//sdk/fidl/fuchsia.audio.device:fuchsia.audio.device_rust_fdomain",
    "//userspace/developer/ffx/core:lib",
    "//userspace/media/audio/lib/rust:fuchsia_audio_fdomain",
    "//third_party/rust_crates:argh",
  ]

  deps = [
    "//sdk/fidl/fuchsia.audio.controller:fuchsia.audio.controller_rust_fdomain",
    "//sdk/fidl/fuchsia.audio.device:fuchsia.audio.device_rust_fdomain",
    "//sdk/fidl/fuchsia.hardware.audio:fuchsia.hardware.audio_rust_fdomain",
    "//sdk/fidl/fuchsia.hardware.audio.signalprocessing:fuchsia.hardware.audio.signalprocessing_rust_fdomain",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain",
    "//sdk/fidl/fuchsia.media:fuchsia.media_rust_fdomain",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-types",
    "//userspace/developer/ffx/command/error:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/plugins/audio/common:ffx_audio_common",
    "//userspace/lib/fdomain/client",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/media/audio/lib/rust:fuchsia_audio_fdomain",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:base64",
    "//third_party/rust_crates:blocking",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:prettytable-rs",
    "//third_party/rust_crates:serde",
  ]

  test_deps = [
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/fdomain/local",
    "//userspace/lib/fidl/rust/fidl_test_util",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:test-case",
  ]

  args_sources = [ "src/args.rs" ]

  sources = [
    "src/connect.rs",
    "src/control.rs",
    "src/info.rs",
    "src/lib.rs",
    "src/list.rs",
    "src/serde_ext.rs",
  ]

  ## Uncomment this line, to enable all lints during local development.
  # configs = [ "//products/build/config/rust/lints:clippy_warn_all" ]
}
