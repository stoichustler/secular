import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_audio_record") {
  sdk_category = "not-yet-specified"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  args_with_unit_tests = true

  args_deps = [
    "//sdk/fidl/fuchsia.audio.controller:fuchsia.audio.controller_rust",
    "//sdk/fidl/fuchsia.media:fuchsia.media_rust",
    "//userspace/developer/ffx/core:lib",
    "//userspace/media/audio/lib/rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]

  deps = [
    "//sdk/fidl/fuchsia.audio.controller:fuchsia.audio.controller_rust_fdomain",
    "//sdk/fidl/fuchsia.media:fuchsia.media_rust_fdomain",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/plugins/audio/common:ffx_audio_common",
    "//userspace/lib/fdomain/client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:blocking",
    "//third_party/rust_crates:futures",
  ]

  test_deps = [
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/fdomain/local",
    "//userspace/lib/fuchsia",
  ]

  args_sources = [ "src/args.rs" ]

  sources = [ "src/lib.rs" ]

  ## Uncomment this line, to enable all lints during local development.
  # configs = [ "//products/build/config/rust/lints:clippy_warn_all" ]
}
