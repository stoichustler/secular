import("//products/build/rust/rustc_library.gni")

rustc_library("lib") {
  name = "ffx_product_get_version"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/args.rs",
    "src/lib.rs",
    "src/load_config.rs",
    "src/unique_release_info.rs",
  ]

  deps = [
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/assembly/api",
    "//userspace/lib/assembly/partitions_config",
    "//userspace/lib/assembly/product_bundle",
    "//userspace/lib/assembly/release_info",
    "//userspace/lib/assembly/util",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
  ]

  test_deps = [
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/lib/assembly/partitions_config",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
  ]
}
