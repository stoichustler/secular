import("//products/build/tools/bazel2gn/bazel_migration.gni")

if (is_host) {
  rustc_library("lib") {
    sources = [
      "src/lib.rs",
      "src/watcher.rs",
    ]
    crate_name = "manual_targets"
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    visibility = [
      ":*",
      "//userspace/developer/ffx/lib/diagnostics/checks:*",
      "//userspace/developer/ffx/lib/discovery:*",
      "//userspace/developer/ffx/lib/target:*",
      "//userspace/developer/ffx/plugins/target/add:*",
      "//userspace/developer/ffx/plugins/target/remove:*",
    ]
    deps = [
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/addr:lib",
      "//userspace/developer/ffx/lib/fastboot/interface:lib",
      "//userspace/developer/ffx/lib/fastboot/transport/interface:lib",
      "//userspace/developer/ffx/lib/netext:lib",
      "//userspace/developer/ffx/lib/timeout:lib",
      "//userspace/lib/fuchsia-async",
      "//third_party/rust_crates:async-channel",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
    ]
  }
}
if (is_host) {
  rustc_test("lib_test") {
    sources = [
      "src/lib.rs",
      "src/watcher.rs",
    ]
    edition = "2024"
    proc_macro_deps = [ "//third_party/rust_crates:async-trait" ]
    deps = [
             "//userspace/developer/ffx/config:lib",
             "//userspace/developer/ffx/lib/addr:lib",
             "//userspace/developer/ffx/lib/fastboot/interface:lib",
             "//userspace/developer/ffx/lib/fastboot/transport/interface:lib",
             "//userspace/developer/ffx/lib/netext:lib",
             "//userspace/developer/ffx/lib/timeout:lib",
             "//userspace/lib/fuchsia-async",
             "//third_party/rust_crates:async-channel",
             "//third_party/rust_crates:async-lock",
             "//third_party/rust_crates:log",
             "//third_party/rust_crates:serde_json",
             "//third_party/rust_crates:thiserror",
             "//third_party/rust_crates:tokio",
           ] +
           [
             "//userspace/lib/fuchsia",
             "//third_party/rust_crates:anyhow",
             "//third_party/rust_crates:futures",
             "//third_party/rust_crates:pretty_assertions",
             "//third_party/rust_crates:serial_test",
           ]
    visibility = [
      ":*",
      "//userspace/developer/ffx:*",
    ]
  }
}
