import("//products/build/rust/rustc_library.gni")

if (is_host) {
  rustc_library("lib") {
    name = "ffx_gce"
    edition = "2024"
    with_unit_tests = true

    deps = [
      "//products/build/sdk/meta:rust",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/discovery:lib",
      "//userspace/developer/ffx/lib/pkg",
      "//userspace/developer/ffx/lib/port_picker:lib",
      "//userspace/developer/ffx/lib/ssh:lib",
      "//userspace/developer/ffx/lib/uefi_disk:lib",
      "//userspace/developer/lib/credentials:lib",
      "//userspace/lib/assembly/product_bundle",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/fuchsia-hyper",
      "//userspace/lib/gcs",
      "//third_party/rust_crates:camino",
      "//third_party/rust_crates:flate2",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:home",
      "//third_party/rust_crates:http-body-util",
      "//third_party/rust_crates:hyper",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:nix",
      "//third_party/rust_crates:rand",
      "//third_party/rust_crates:serde",
      "//third_party/rust_crates:serde_json",
      "//third_party/rust_crates:sha2",
      "//third_party/rust_crates:tar",
      "//third_party/rust_crates:tempfile",
      "//third_party/rust_crates:thiserror",
      "//third_party/rust_crates:tokio",
      "//third_party/rust_crates:url",
    ]

    test_deps = [ "//userspace/lib/fuchsia" ]

    sources = [
      "src/client.rs",
      "src/context.rs",
      "src/error.rs",
      "src/image.rs",
      "src/lib.rs",
      "src/models.rs",
      "src/tunnel.rs",
    ]
  }

  group("gce") {
    public_deps = [ ":lib" ]
  }

  group("tests") {
    testonly = true
    deps = [ ":lib_test" ]
  }
}
