load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = ["src/lib.rs"],
    crate_name = "usb_fastboot_discovery",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    test_deps = [
        "//userspace/lib/fuchsia",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
    visibility = [
        ":__pkg__",
        "//userspace/developer/ffx:__pkg__",
        "//userspace/developer/ffx/lib/diagnostics/checks:__pkg__",
        "//userspace/developer/ffx/lib/discovery:__pkg__",
        "//userspace/developer/ffx/lib/fastboot/connection_factory:__pkg__",
        "//userspace/developer/ffx/lib/fastboot/interface:__pkg__",
        "//userspace/developer/ffx/lib/fastboot/transport/factory:__pkg__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//userspace/lib/fuchsia-async",
        "//userspace/lib/usb_rs",
        "//third_party/rust_crates/vendor:async-channel",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
