load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = [
        "src/lib.rs",
        "src/target_addr.rs",
    ],
    crate_name = "addr",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    test_deps = [
        "//userspace/connectivity/lib/net-declare",
        "//userspace/lib/fuchsia",
    ],
    version = "0.1.0",
    visibility = [
        "//userspace/developer/ffx:__subpackages__",
        "//tools/funnel:__subpackages__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.net:fuchsia.net_rust_common",
        "//userspace/developer/ffx/fidl:fuchsia.developer.ffx_rust_common",
        "//userspace/developer/ffx/lib/netext:lib",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
