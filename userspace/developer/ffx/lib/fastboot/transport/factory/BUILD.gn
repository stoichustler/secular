import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_test.gni")
import("//products/build/testing/test_spec.gni")

assert(is_host,
       "ffx_fastboot_transport_factory is for use with the host toolchain only")

rustc_library("lib") {
  name = "ffx_fastboot_transport_factory"
  edition = "2024"
  with_unit_tests = true

  visibility = [
    ":*",
    "//userspace/developer/ffx/lib/fastboot/*",
  ]

  deps = [
    "//userspace/developer/fastboot:lib",
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/diagnostics/analytics:lib",
    "//userspace/developer/ffx/lib/discovery:lib",
    "//userspace/developer/ffx/lib/fastboot/interface:lib",
    "//userspace/developer/ffx/lib/fastboot/transport/interface:lib",
    "//userspace/developer/ffx/lib/netext:lib",
    "//userspace/developer/ffx/lib/usb_fastboot_discovery:lib",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:tokio",
  ]

  test_deps = [
    "//userspace/lib/analytics/rust:lib",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:tempfile",
  ]

  sources = [
    "src/analytics.rs",
    "src/helpers.rs",
    "src/lib.rs",
    "src/tcp.rs",
    "src/udp.rs",
    "src/usb.rs",
  ]
}

group("ffx_fastboot_transport_factory") {
  public_deps = [ ":lib" ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test" ]
}
