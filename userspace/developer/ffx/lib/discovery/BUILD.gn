import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_test.gni")
import("//products/build/testing/test_spec.gni")

assert(is_host, "discovery is for use with the host toolchain only")

rustc_library("lib") {
  name = "discovery"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
    "//userspace/developer/fastboot:lib",
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/addr:lib",
    "//userspace/developer/ffx/lib/emulator_instance:lib",
    "//userspace/developer/ffx/lib/fastboot/transport/interface:lib",
    "//userspace/developer/ffx/lib/fastboot_file_discovery:lib",
    "//userspace/developer/ffx/lib/manual_targets:lib",
    "//userspace/developer/ffx/lib/mdns_discovery:lib",
    "//userspace/developer/ffx/lib/uart_driver_api:lib",
    "//userspace/developer/ffx/lib/usb_driver_api:lib",
    "//userspace/developer/ffx/lib/usb_fastboot_discovery:lib",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fidl/rust/fidl_message",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:chrono",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:nix",
    "//third_party/rust_crates:notify",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tokio",
  ]

  test_deps = [
    "//userspace/connectivity/lib/net-declare",
    "//userspace/developer/ffx/config:lib",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/desc.rs",
    "src/emulator_watcher.rs",
    "src/error.rs",
    "src/events.rs",
    "src/fastboot_file_watcher.rs",
    "src/gce_watcher.rs",
    "src/instance_watcher.rs",
    "src/lib.rs",
    "src/merge.rs",
    "src/query.rs",
    "src/uart_watcher.rs",
    "src/usb_vsock_watcher.rs",
  ]
}

group("discovery") {
  public_deps = [ ":lib" ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test" ]
}
