import("//products/build/product.gni")
import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_test.gni")
import("//products/build/testing/test_spec.gni")

assert(is_host, "pbms is for use with the host toolchain only")

rustc_library("lib") {
  name = "pbms"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/lib/credentials:lib",
    "//userspace/lib/assembly/product_bundle",
    "//userspace/lib/fuchsia-hyper",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//userspace/lib/transfer_manifest",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-fs",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:http-body-util",
    "//third_party/rust_crates:hyper",
    "//third_party/rust_crates:hyper-util",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:url",
  ]

  test_deps = [
    "//userspace/developer/ffx/lib/pkg:empty-repo-keys",
    "//userspace/developer/ffx/lib/pkg:empty-repo-metadata",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:tempfile",
  ]

  sources = [
    "src/gcs.rs",
    "src/lib.rs",
    "src/pbms.rs",
    "src/transfer_manifest.rs",
  ]
}

group("pbms") {
  testonly = true
  deps = [
    ":lib",
    ":tests",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test" ]
}
