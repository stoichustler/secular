assert(is_host, "auth is for use with the host toolchain only")

import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_test.gni")

rustc_library("auth") {
  name = "auth"
  edition = "2024"

  deps = [
    "//userspace/developer/ffx/lib/fho:lib",

    # TODO(b/302078392): remove this when AuthFlowChoice is moved out of PBMS.
    "//userspace/developer/ffx/lib/pbms:lib",
    "//userspace/developer/lib/credentials:lib",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]

  sources = [ "src/lib.rs" ]
}

rustc_test("auth_test") {
  edition = "2024"
  deps = [
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/pbms:lib",
    "//userspace/developer/lib/credentials:lib",
    "//userspace/lib/fuchsia",
    "//userspace/lib/gcs",
    "//userspace/lib/structured_ui",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:thiserror",
  ]
  sources = [ "src/lib.rs" ]
}

group("tests") {
  testonly = true
  deps = [ ":auth_test" ]
}
