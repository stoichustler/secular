import("//products/build/rust/rustc_library.gni")

assert(is_host, "target_connector is host only")

rustc_library("lib") {
  name = "target_connector"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//userspace/developer/ffx/command/error:lib",
    "//userspace/developer/ffx/fidl:fuchsia.developer.ffx_rust",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/target/behavior:lib",
    "//userspace/developer/ffx/lib/target_errors:lib",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:log",
  ]

  test_deps = [
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/addr:lib",
    "//userspace/developer/ffx/lib/target:lib",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:serde_json",
  ]

  sources = [ "src/lib.rs" ]
}

group("connector") {
  deps = [ ":lib" ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test($host_toolchain)" ]
}
