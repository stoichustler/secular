import("//products/build/components/fuchsia_package.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/testing/environments.gni")

if (is_host) {
  rustc_test("ffx_connection_test") {
    testonly = true
    edition = "2024"
    source_root = "src/tests.rs"

    sources = [
      "src/tests.rs",
      "src/util.rs",
    ]
    deps = [
      "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
      "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/isolate:lib",
      "//userspace/developer/ffx/lib/target:lib",
      "//userspace/lib/fdomain/client",
      "//userspace/lib/fuchsia",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/testing/fixture",
      "//userspace/testing/fidl/proxy_stressor/fidl:test.proxy.stress_rust_fdomain",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:async-lock",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
    ]

    data_deps = [
      "//userspace/developer/ffx:test_data",
      "//userspace/developer/ffx/plugins/component:ffx_component_tool_test_data",
      "//userspace/developer/ffx/plugins/target:ffx_target_tool_test_data",
    ]

    package_deps = [ ":ffx_connection_test_components" ]

    test_environments = all_fuchsia_envs

    # TODO(https://fxbug.dev/42143551): The arm64 emulator is run from an arm64 host but we only
    # support running tests on x64 hosts.
    if (target_cpu == "arm64") {
      test_environments -= [ emu_env ]
    }
  }
}

fuchsia_package("ffx_connection_test_components") {
  testonly = true
  deps = [ "//userspace/testing/fidl/proxy_stressor" ]
}

group("tests") {
  deps = [ ":ffx_connection_test_components($target_toolchain)" ]
  testonly = true
}

group("e2e_tests") {
  deps = [ ":ffx_connection_test($host_toolchain)" ]
  testonly = true
}
