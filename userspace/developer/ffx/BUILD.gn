# Slim ffx leftovers required by package-tool / assembly host libraries.
# Plugins, frontends, and the ffx binary are not part of Secular.

import("//products/build/host.gni")
import("//products/build/tools/json_merge/json_merge.gni")

group("ffx") {
  testonly = true
  public_deps = [ ":ffx-defaults.json($host_toolchain)" ]
}

group("tests") {
  testonly = true
}

if (is_host) {
  json_merge("ffx-defaults.json") {
    sources = [ "//userspace/developer/ffx/data/config.json" ]
    deep_merge = true
  }
}
