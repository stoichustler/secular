# Defines the host daemon executable `ffx-uart-driver` and its CLI wrapper
# library
# `ffx_uart_host_driver`.

import("//products/build/host.gni")
import("//products/build/rust/rustc_library.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

if (is_host) {
  rustc_library("lib") {
    name = "ffx_uart_host_driver"
    edition = "2024"
    with_unit_tests = true

    deps = [
      "impl:lib",
      "//userspace/developer/ffx/command:lib",
      "//userspace/developer/ffx/config:lib",
      "//userspace/developer/ffx/lib/fho:lib",
      "//userspace/developer/ffx/lib/logging:lib",
      "//userspace/developer/ffx/lib/uart_driver_api:lib",
      "//userspace/developer/ffx/tools/uart:lib",
      "//userspace/lib/analytics/rust:lib",
      "//third_party/rust_crates:argh",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:serde_json",
    ]

    test_deps = [
      "//userspace/lib/fuchsia",
      "//third_party/rust_crates:tempfile",
    ]

    sources = [
      "src/analytics.rs",
      "src/lib.rs",
    ]
  }

  ffx_tool("ffx_uart_driver") {
    edition = "2024"
    output_name = "ffx-uart-driver"
    deps = [
      ":lib",
      "//userspace/developer/ffx/lib/version:lib",
      "//userspace/lib/fuchsia-async",
    ]
    sources = [ "src/main.rs" ]
  }

  group("uart_driver") {
    public_deps = [
      ":ffx_uart_driver",
      ":ffx_uart_driver_host_tool",
    ]
  }

  group("bin") {
    public_deps = [ ":ffx_uart_driver_versioned" ]
  }

  group("tests") {
    testonly = true
    deps = [
      ":lib_test",
      "impl:lib_test",
    ]
  }
} else {
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}
