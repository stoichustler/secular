import("//userspace/developer/ffx/config.gni")

# The list of tools under this directory
_tools = [
  "//userspace/developer/ffx/plugins/assembly",
  "//userspace/developer/ffx/plugins/audio",
  "//userspace/developer/ffx/plugins/component",
  "//userspace/developer/ffx/plugins/coverage",
  "//userspace/developer/ffx/plugins/debug",
  "//userspace/developer/ffx/plugins/emulator",
  "//userspace/developer/ffx/plugins/forward",
  "//userspace/developer/ffx/plugins/fuzz",
  "//userspace/developer/ffx/plugins/inspect",
  "//userspace/developer/ffx/plugins/log",
  "//userspace/developer/ffx/plugins/package",
  "//userspace/developer/ffx/plugins/profile",
  "//userspace/developer/ffx/plugins/product",
  "//userspace/developer/ffx/plugins/product_bundle",
  "//userspace/developer/ffx/plugins/process",
  "//userspace/developer/ffx/plugins/repository",
  "//userspace/developer/ffx/plugins/scrutiny",
  "//userspace/developer/ffx/plugins/session",
  "//userspace/developer/ffx/plugins/setui",
  "//userspace/developer/ffx/plugins/test",
  "//userspace/developer/ffx/plugins/trace",
  "//userspace/developer/ffx/plugins/wlan",
  "auth",
  "bluetooth",
  "driver",
  "echo",
  "efi",
  "gce",
  "monitor",
  "power",
  "profiler",
  "speedtest",
  "starnix",
  "storage",
  "triage",
  "uart",
  "uart_driver",
  "usb",
  "usb_driver",
  "wm",
  "verify-ssh-keys",
]

group("tools") {
  public_deps = _tools

  # Any plugins that can be built in dual mode should be listed here, and that
  # will cause them to be built as host tools that ffx can invoke.
  if (ffx_build_dual_mode_plugins_as_subtools) {
    public_deps += dual_mode_subtools  # from config.gni
  }
}

group("bins") {
  public_deps = []
  foreach(tool, _tools) {
    public_deps += [ "$tool:bin" ]
  }

  if (ffx_build_dual_mode_plugins_as_subtools) {
    public_deps += dual_mode_subtool_bins  # from config.gni
  }
}

group("tests") {
  testonly = true
  deps = []
  foreach(tool, _tools) {
    deps += [ "$tool:tests" ]
  }

  # Playground is experimental so it's not in _tools but we still want to run
  # the tests.
  deps += [ "playground:tests" ]

  if (ffx_build_dual_mode_plugins_as_subtools) {
    deps += dual_mode_subtool_tests  # from config.gni
  }
}

group("host_tests") {
  testonly = true
  deps = [ "power:host_tests" ]
}
