import("//products/build/rust/rustc_library.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

assert(is_host, "ffx driver subtool is intended for host toolchain use only")

rustc_library("ffx_driver") {
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_rust_fdomain",
    "//sdk/fidl/fuchsia.driver.registrar:fuchsia.driver.registrar_rust_fdomain",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//sdk/fidl/fuchsia.test.manager:fuchsia.test.manager_rust_fdomain",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/rcs:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/devices/bin/driver_tools:lib_fdomain",
    "//userspace/devices/bin/driver_tools/connector:lib_fdomain",
    "//userspace/lib/fdomain/client",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/sys/lib/component_debug:component_debug_fdomain",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:rustyline",
    "//third_party/rust_crates:serde_json",
  ]
  sources = [
    "src/args.rs",
    "src/lib.rs",
  ]
}

ffx_tool("ffx_driver_tool") {
  edition = "2024"
  output_name = "ffx-driver"
  deps = [
    ":ffx_driver",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/lib/fuchsia-async",
  ]
  sources = [ "src/main.rs" ]

  sdk_target_name = "sdk"
  sdk_category = "partner"
}

group("driver") {
  public_deps = [ ":ffx_driver_tool_host_tool" ]
}

group("bin") {
  public_deps = [ ":ffx_driver_tool_versioned" ]
}

group("tests") {
  testonly = true
  deps = [ ":ffx_driver_test" ]
}
