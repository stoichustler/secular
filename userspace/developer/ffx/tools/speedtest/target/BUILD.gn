import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("bin") {
  name = "speedtest"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.developer.ffx.speedtest:fuchsia.developer.ffx.speedtest_rust",
    "//userspace/developer/ffx/tools/speedtest/common:speedtest",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/main.rs" ]

  configs += [ "//products/build/config/rust/lints:deny_unused_results" ]
}

fuchsia_component("component") {
  component_name = "speedtest"
  manifest = "meta/speedtest.cml"
  deps = [ ":bin" ]
}

fuchsia_package("speedtest") {
  package_name = "speedtest"
  deps = [ ":component" ]
}
