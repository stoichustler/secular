import("//products/build/rust/rustc_library.gni")
import("//userspace/developer/ffx/build/ffx_plugin.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

rustc_library("lib") {
  name = "ffx_tool_playground"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/analytics.rs",
    "src/cf_fs.rs",
    "src/host_fs.rs",
    "src/lib.rs",
    "src/presentation.rs",
    "src/repl.rs",
    "src/strict_mutex.rs",
    "src/term_util.rs",
    "src/toolbox_fs.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust_fdomain",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain",
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust_fdomain",
    "//sdk/rust/zx-status",
    "//sdk/rust/zx-status-ext",
    "//userspace/developer/ffx/config:lib",
    "//userspace/developer/ffx/lib/errors:lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/developer/ffx/lib/rcs:lib",
    "//userspace/developer/ffx/lib/target/holders:lib",
    "//userspace/developer/ffx/lib/writer:lib",
    "//userspace/developer/ffx/playground",
    "//userspace/lib/analytics/rust:lib",
    "//userspace/lib/buf-read-ext",
    "//userspace/lib/fdomain/client",
    "//userspace/lib/fidl_codec/rust:fidl_codec_fdomain",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-fs:fuchsia-fs_fdomain",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//userspace/sys/lib/component_debug:component_debug_fdomain",
    "//userspace/sys/lib/moniker",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:async-fs",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:crossterm",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:unicode-width",
    "//third_party/rust_crates:vte",
  ]

  test_deps = [
    "//userspace/lib/fdomain/client",
    "//userspace/lib/fdomain/local",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:tempfile",
  ]
}

ffx_tool("ffx_playground") {
  edition = "2024"
  output_name = "ffx-playground"
  deps = [
    ":lib",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/lib/fuchsia-async",
  ]
  sources = [ "src/main.rs" ]
}

group("playground") {
  public_deps = [
    ":ffx_playground",
    ":ffx_playground_host_tool",
  ]
}

group("bin") {
  public_deps = [ ":ffx_playground_versioned" ]
}

group("tests") {
  testonly = true

  deps = [ ":lib_test" ]
}
