import("//products/build/rust/rustc_library.gni")

rustc_library("lib") {
  name = "usb_driver_impl"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/adapters.rs",
    "src/lib.rs",
  ]

  deps = [
    "//userspace/developer/ffx/fidl/usb:fuchsia.ffx.usb_rust_common",
    "//userspace/developer/ffx/lib/metrics:lib",
    "//userspace/developer/ffx/lib/usb_vsock_host",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fidl/rust/fidl_message",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:tokio",
  ]

  test_deps = [
    "//userspace/developer/lib/usb_vsock",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:tempfile",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":lib_test($host_toolchain)" ]
}
