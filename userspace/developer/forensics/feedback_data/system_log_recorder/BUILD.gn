visibility = [ "//userspace/developer/forensics/*" ]

###############################################################################
# SOURCES
###############################################################################
source_set("main") {
  sources = [
    "main.cc",
    "main.h",
  ]

  deps = [
    ":src",
    "encoding:production",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
    "//userspace/developer/forensics/feedback:config",
    "//userspace/developer/forensics/feedback:redactor_factory",
    "//userspace/developer/forensics/feedback_data:constants",
    "//userspace/developer/forensics/utils/redact",
    "//userspace/lib/timekeeper:system",
    "//zircon/system/ulib/trace-provider",
  ]

  visibility += [ "//userspace/developer/forensics/*" ]
}

source_set("src") {
  sources = [
    "controller.cc",
    "controller.h",
    "disk_backed_logs_metadata.cc",
    "disk_backed_logs_metadata.h",
    "log_collector.cc",
    "log_collector.h",
    "log_message_store.cc",
    "log_message_store.h",
    "log_stats.h",
    "shutdown_message.cc",
    "shutdown_message.h",
    "system_log_recorder.cc",
    "system_log_recorder.h",
    "writer.cc",
    "writer.h",
  ]

  public_deps = [
    "encoding:encoder",
    "fidl:fuchsia.feedback.internal_cpp",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_hlcpp",
    "//sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_hlcpp",
    "//sdk/lib/async_patterns/cpp",
    "//sdk/lib/fit",
    "//sdk/lib/fit-promise",
    "//sdk/lib/sys/cpp",
    "//userspace/developer/forensics/feedback_data:log_buffer",
    "//userspace/developer/forensics/feedback_data:log_source",
    "//userspace/developer/forensics/utils:logs",
    "//userspace/developer/forensics/utils:storage_size",
    "//userspace/developer/forensics/utils/redact",
    "//userspace/lib/diagnostics/accessor2logger",
  ]

  deps = [
    ":reader",
    "encoding:production",
    "//sdk/lib/syslog/cpp",
    "//userspace/developer/forensics/feedback_data:constants",
    "//userspace/developer/forensics/utils:purge_memory",
    "//userspace/developer/forensics/utils:vmo",
    "//userspace/developer/forensics/utils/cobalt",
    "//userspace/lib/files",
    "//userspace/lib/fxl",
    "//third_party/rapidjson",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/trace",
  ]
}

# This file is not needed in system_log_recorder per se, but should be kept in
# sync with the writer.
source_set("reader") {
  sources = [
    "reader.cc",
    "reader.h",
  ]

  public_deps = [
    "encoding:decoder",
    "//sdk/lib/fit",
  ]

  deps = [
    "//sdk/lib/syslog/cpp",
    "//userspace/developer/forensics/feedback_data:constants",
    "//userspace/lib/files",
    "//userspace/lib/fsl",
    "//userspace/lib/fxl",
    "//third_party/re2",
    "//zircon/system/ulib/trace",
  ]
}
