  deps = [
    ":constants",
    "//sdk/lib/syslog/cpp",
    "//userspace/developer/forensics/utils:archive",
    "//userspace/lib/fsl",
    "//userspace/lib/uuid",
  ]
}

source_set("errors") {
  sources = [ "errors.h" ]

  public_deps = [
    "//sdk/lib/syslog/cpp",
    "//userspace/developer/forensics/utils:errors",
