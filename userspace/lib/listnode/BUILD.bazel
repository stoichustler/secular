load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//products/build/bazel/rules/cc:fx_cc_library.bzl", "fx_cc_library")
load("//products/build/bazel/rules/host_tests:host_test.bzl", "host_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

fx_cc_library(
    name = "listnode",
    hdrs = ["listnode.h"],
    visibility = [
        "//userspace/camera/drivers/usb_video:__pkg__",
        "//userspace/connectivity/bluetooth/hci/transport/usb:__pkg__",
        "//userspace/connectivity/ethernet/drivers/third_party/igc:__pkg__",
        "//userspace/devices/block/drivers/virtio:__pkg__",
        "//userspace/sys/bin/psutils:__pkg__",
        "//userspace/ui/input/bin/hid:__pkg__",
    ],
    alwayslink = True,
)

# @bazel2gn:skip
fx_cc_binary(
    name = "listnode-tests",
    testonly = True,
    # listnode should work in both C and C++.
    srcs = [
        "listnode-test.c",
        "listnode-test.cc",
    ],
    copts = ["-Wno-vla-cxx-extension"],
    tags = ["manual"],
    deps = [
        ":listnode",
        "//zircon/system/ulib/zxtest",
    ] + select({
        "@platforms//os:fuchsia": ["//sdk/lib/fdio"],
        "//conditions:default": [],
    }),
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
host_test(
    name = "listnode_host_tests",
    binary = ":listnode-tests",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//userspace/lib:__pkg__"],
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
fx_unittest_package(
    name = "listnode-package",
    unit_tests = [":listnode-tests"],
    visibility = ["//userspace/lib:__pkg__"],
)
