load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "mapped-vmo",
    srcs = [
        "src/immutable.rs",
        "src/lib.rs",
        "src/truncated_immutable.rs",
    ],
    edition = "2024",
    visibility = [
        "//userspace/secular:__subpackages__",
        "//userspace/connectivity:__subpackages__",
        "//userspace/devices:__subpackages__",
        "//userspace/graphics:__subpackages__",
        "//userspace/lib/ui/carnelian:__pkg__",
        "//userspace/performance:__subpackages__",
        "//userspace/sys:__subpackages__",
        "//userspace/testing/system-validation:__pkg__",
        "//userspace/ui:__subpackages__",
        "//userspace/virtualization:__subpackages__",
        "//vendor/google:__subpackages__",
        "//zircon:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//userspace/lib/fuchsia-runtime",
        "//userspace/lib/shared-buffer",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "mapped-vmo_test",
    crate = ":mapped-vmo",
    visibility = ["//visibility:private"],
    deps = ["//third_party/rust_crates/vendor:test-case"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "mapped-vmo-tests",
    unit_tests = [":mapped-vmo_test"],
    visibility = ["//visibility:public"],
)
