    name = "escrow",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_component_escrow",
    edition = "2024",
    visibility = ["//userspace/lib/fuchsia-component:__pkg__"],
    deps = [
        "//sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
