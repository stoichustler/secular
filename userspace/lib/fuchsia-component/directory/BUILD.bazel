load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "directory",
    srcs = ["src/lib.rs"],
    crate_name = "fuchsia_component_directory",
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    test_deps = [
        "//userspace/lib/fuchsia-async",
        "//userspace/lib/fuchsia-fs",
        "//userspace/storage/lib/vfs/rust:vfs",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
    visibility = ["//:__subpackages__"],
    with_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//userspace/lib/fidl/rust/fidl",
        "//third_party/rust_crates/vendor:anyhow",
    ],
)
