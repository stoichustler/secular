import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("rust-log-crasher") {
  edition = "2024"
  output_name = "rust_log_crasher"
  testonly = true
  sources = [ "src/main.rs" ]

  deps = [
    "//userspace/lib/diagnostics/log/rust/fidl:fuchsia.diagnostics.crasher_rust",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("component") {
  component_name = "crasher"
  testonly = true
  manifest = "meta/crasher.cml"
  deps = [ ":rust-log-crasher" ]
}
