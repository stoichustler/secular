import("//products/build/bazel/bazel_test_suite.gni")
import("//products/build/config/fuchsia/target_api_level.gni")

bazel_test_suite("diagnostics-message-tests") {
  target_tests =
      [ "//userspace/lib/diagnostics/log/message/rust:diagnostics-message-tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":diagnostics-message-tests",
    "cpp-log-decoder:tests",
  ]
}

