group("rust") {
  public_deps = [ ":lib" ]
  visibility = [
    ":*",
    "//userspace/diagnostics/archivist/*",
    "//userspace/lib/diagnostics/fake-log-sink/rust:*",
    "//userspace/lib/diagnostics/log/message/rust/cpp-log-decoder:*",
    "//userspace/lib/diagnostics/reader/rust:*",
    "//userspace/starnix/kernel/core:*",
  ]
}
rustc_library("lib") {
  sources = [
    "src/constants.rs",
    "src/error.rs",
    "src/ffi.rs",
    "src/lib.rs",
    "src/test.rs",
  ]
  crate_name = "diagnostics_message"
  edition = "2024"
  lint_config = "//products/build/config/rust/lints:clippy_warn_all"
  visibility = [
    ":*",
    "//userspace/diagnostics/lib/log-command:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/diagnostics/log/encoding/rust",
    "//userspace/sys/lib/moniker",
    "//third_party/rust_crates:bumpalo",
    "//third_party/rust_crates:byteorder",
    "//third_party/rust_crates:flyweights",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
  ]
  if (current_build_target_api_level == "HEAD" ||
      current_build_target_api_level == "PLATFORM") {
    deps += [ "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust" ]
  }
}
