load("//products/build/bazel/rules/rust:defs.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "encoding-bin",
    srcs = [
        "src/common.rs",
        "src/encoding.rs",
    ],
    crate_name = "diagnostics_log_encoding_bench",
    crate_root = "src/encoding.rs",
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/rust/zx",
        "//userspace/developer/fuchsia-criterion",
        "//userspace/lib/diagnostics/log/encoding/rust",
        "//userspace/lib/diagnostics/log/rust",
        "//userspace/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "core-bin",
    srcs = ["src/core.rs"],
    crate_name = "diagnostics_log_bench",
    crate_root = "src/core.rs",
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//userspace/developer/fuchsia-criterion",
        "//userspace/diagnostics/lib/ring-buffer",
        "//userspace/lib/diagnostics/log/rust",
        "//userspace/lib/fidl/rust/fidl",
        "//userspace/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:log",
    ],
)

rustc_binary(
    name = "decoding-bin",
    srcs = [
        "src/common.rs",
        "src/decoding.rs",
    ],
    crate_name = "diagnostics_log_decoding_bench",
    crate_root = "src/decoding.rs",
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    deps = [
        "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
        "//sdk/rust/zx",
        "//userspace/developer/fuchsia-criterion",
        "//userspace/lib/diagnostics/log/encoding/rust",
        "//userspace/lib/diagnostics/log/rust",
        "//userspace/lib/fuchsia-runtime",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:log",
    ],
)
