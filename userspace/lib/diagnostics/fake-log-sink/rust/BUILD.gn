import("//products/build/components/fuchsia_unittest_package.gni")
import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_staticlib.gni")

_sources = [ "src/lib.rs" ]
_deps = [
  "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
  "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
  "//userspace/diagnostics/lib/ring-buffer",
  "//userspace/lib/diagnostics/log/message/rust",
  "//userspace/lib/fidl/rust/fidl",
  "//userspace/lib/fuchsia-async",
  "//userspace/lib/fuchsia-sync",
  "//third_party/rust_crates:futures",
]

rustc_library("rust") {
  name = "fake-log-sink"
  with_unit_tests = true
  testonly = true
  edition = "2024"

  sources = _sources
  deps = _deps
  test_deps = [
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/log/encoding/rust",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

rustc_staticlib("rust_ffi") {
  testonly = true
  edition = "2024"
  features = [ "ffi" ]
  visibility = [
    ":*",
    "//userspace/lib/diagnostics/fake-log-sink/cpp:*",
    "//userspace/lib/diagnostics/log/message/rust/cpp-log-decoder:*",
  ]
  public = [ "fake_log_sink.h" ]
  sources = _sources
  deps = _deps + [
           "//sdk/rust/zx",
           "//userspace/lib/diagnostics/log/message/rust/cpp-log-decoder:lib",
         ]
}

fuchsia_unittest_package("fake-log-sink-tests") {
  manifest = "meta/fake-log-sink-test.cml"
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fake-log-sink-tests" ]
}
