import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")

rustc_test("integration_tests_bin") {
  name = "archive_reader_integration_test"
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//userspace/lib/diagnostics/reader/rust",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
  ]

  sources = [ "src/lib.rs" ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("archive_reader_integration_test") {
  testonly = true
  deps = [ ":integration_tests_bin" ]
  manifest = "meta/archive_reader_integration_test.cml"
}

fuchsia_test_package("archive-reader-integration-tests") {
  test_components = [ ":archive_reader_integration_test" ]
  deps = [ "//userspace/diagnostics/archivist:archivist-for-embedding-bundle" ]
}

group("tests") {
  testonly = true
  deps = [ ":archive-reader-integration-tests" ]
}
