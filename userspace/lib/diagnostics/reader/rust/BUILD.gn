import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")

# Uses current_build_target_api_level from
# import("//products/build/config/fuchsia/target_api_level.gni").

group("tests") {
  testonly = true
  deps = [
    ":diagnostics-reader-tests",
    "tests",
  ]
}

# Kept in GN because `diagnostics-reader-tests` packages
# `//userspace/diagnostics/archivist:archivist-for-embedding-bundle` and
# `//userspace/lib/diagnostics/inspect/runtime/rust:inspect_test_component_default`,
# neither of which has a Bazel target yet.
rustc_test("lib_test") {
  edition = "2024"
  output_name = "diagnostics_reader_lib_test"

  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.mem:fuchsia.mem_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/diagnostics/hierarchy/rust",
    "//userspace/lib/diagnostics/log/message/rust",
    "//userspace/lib/diagnostics/log/rust",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:async-stream",
    "//third_party/rust_crates:ciborium",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:pin-project",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
  ]

  if (current_build_target_api_level == "PLATFORM" ||
      current_build_target_api_level == "HEAD") {
    deps += [ "//userspace/lib/fuchsia-sync" ]
  }

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package("diagnostics-reader-tests") {
  manifest = "meta/diagnostics-reader-unittest.cml"
  deps = [
    ":lib_test",
    "//userspace/diagnostics/archivist:archivist-for-embedding-bundle",
    "//userspace/lib/diagnostics/inspect/runtime/rust:inspect_test_component_default",
  ]
}

