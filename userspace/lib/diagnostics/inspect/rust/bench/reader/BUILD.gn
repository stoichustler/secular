import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("reader-bin") {
  name = "inspect_rust_reader_benchmarks"
  edition = "2024"
  with_unit_tests = true

  source_root = "src/main.rs"

  deps = [
    "//userspace/developer/fuchsia-criterion",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/inspect/rust/bench/utils:fuchsia_inspect_bench_utils",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
  ]

  sources = [ "src/main.rs" ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("reader-component") {
  component_name = "reader"
  manifest = "meta/reader.cml"
  deps = [ ":reader-bin" ]
}
