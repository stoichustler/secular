load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

rustc_library(
    name = "inspect_stubs",
    srcs = [
        "src/lib.rs",
        "src/stubs.rs",
    ],
    crate_name = "inspect_stubs",
    crate_root = "src/lib.rs",
    edition = "2024",
    test_deps = [
        "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
        "//userspace/lib/fuchsia",
    ],
    version = "0.1.0",
    with_unit_tests = True,
    deps = [
        "//userspace/lib/diagnostics/inspect/rust:fuchsia-inspect",
        "//userspace/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:flyweights",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)
