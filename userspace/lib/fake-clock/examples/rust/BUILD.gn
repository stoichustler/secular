import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("example_bin") {
  testonly = true
  name = "rust_example_bin"
  edition = "2024"

  deps = [
    "//sdk/rust/zx",
    "//userspace/lib/fake-clock/examples/fidl:fuchsia.fakeclock.test_rust",
    "//userspace/lib/fake-clock/named-timer",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/main.rs" ]

  non_rust_deps = [ "//userspace/lib/fake-clock/lib" ]
}

rustc_test("test_bin") {
  name = "integ_test_bin"
  edition = "2024"

  sources = [ "test/test.rs" ]

  source_root = "test/test.rs"

  deps = [
    "//sdk/rust/zx",
    "//userspace/lib/fake-clock/examples/fidl:fuchsia.fakeclock.test_rust",
    "//userspace/lib/fake-clock/fidl:fidl_rust",
    "//userspace/lib/fake-clock/named-timer",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
  ]
}

fuchsia_component("rust_example") {
  testonly = true
  component_name = "rust_example"
  manifest = "meta/example.cml"
  deps = [ ":example_bin" ]
}

fuchsia_component("rust_integ_test_driver") {
  testonly = true
  component_name = "rust_integ_test_driver"
  manifest = "meta/test_driver.cml"
  deps = [ ":test_bin" ]
}

fuchsia_component("rust_integ_test") {
  testonly = true
  component_name = "rust_integ_test"
  manifest = "meta/test.cml"
}

fuchsia_test_package("fake-clock-rust") {
  test_components = [ ":rust_integ_test" ]
  deps = [
    ":rust_example",
    ":rust_integ_test_driver",
    "//userspace/lib/fake-clock/svc",
  ]
}

group("examples") {
  deps = [ ":fake-clock-rust" ]
  testonly = true
}
