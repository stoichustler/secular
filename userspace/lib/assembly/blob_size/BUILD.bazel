load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "blob_size",
    srcs = [
        "src/blob_size.rs",
        "src/lib.rs",
    ],
    crate_name = "assembly_blob_size",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = [
        "//userspace/developer/ffx/plugins/assembly:__pkg__",
        "//userspace/lib/assembly:__subpackages__",
    ],
    deps = [
        "//userspace/lib/assembly/blobfs",
        "//userspace/lib/assembly/images_config",
        "//userspace/lib/assembly/tool",
        "//userspace/lib/assembly/util",
        "//userspace/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:tempfile",
    ],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
host_rustc_test(
    name = "blob_size_test",
    crate = ":blob_size",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//userspace/lib/assembly:__pkg__"],
    deps = ["//third_party/rust_crates/vendor:serde_json"],
)
