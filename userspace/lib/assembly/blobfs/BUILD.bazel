load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "blobfs",
    srcs = [
        "src/blobfs.rs",
        "src/lib.rs",
        "src/manifest.rs",
    ],
    crate_name = "assembly_blobfs",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    # @bazel2gn:skip
    test_deps = [
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:tempfile",
    ],
    version = "0.1.0",
    visibility = ["//userspace/lib/assembly:__subpackages__"],
    # @bazel2gn:skip
    with_host_unit_tests = True,
    deps = [
        "//userspace/lib/assembly/tool",
        "//userspace/lib/assembly/util",
        "//userspace/lib/utf8_path",
        "//userspace/sys/pkg/lib/fuchsia-hash",
        "//userspace/sys/pkg/lib/fuchsia-merkle",
        "//userspace/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:pathdiff",
        "//third_party/rust_crates/vendor:serde",
    ],
)
