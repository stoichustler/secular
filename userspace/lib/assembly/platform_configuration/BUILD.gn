import("//products/build/rust/rustc_library.gni")

assert(is_host, "Assembly libraries are host-only")

declare_args() {
  # If true, forcefully enables Heapdump for the entire system (including
  # component_manager and all other monikers) during assembly of eng standard
  # builds.
  enable_assembly_heapdump = false
}

rustc_library("platform_configuration") {
  edition = "2024"
  name = "assembly_platform_configuration"
  with_unit_tests = true

  features = []
  if (enable_assembly_heapdump) {
    features += [ "enable_assembly_heapdump" ]
  }

  sources = [
    "src/common.rs",
    "src/lib.rs",
    "src/subsystems.rs",
    "src/subsystems/battery.rs",
    "src/subsystems/bluetooth.rs",
    "src/subsystems/build_info.rs",
    "src/subsystems/component.rs",
    "src/subsystems/connectivity.rs",
    "src/subsystems/development.rs",
    "src/subsystems/diagnostics.rs",
    "src/subsystems/driver_framework.rs",
    "src/subsystems/example.rs",
    "src/subsystems/factory_store_providers.rs",
    "src/subsystems/fonts.rs",
    "src/subsystems/forensics.rs",
    "src/subsystems/graphics.rs",
    "src/subsystems/hwinfo.rs",
    "src/subsystems/icu.rs",
    "src/subsystems/intl.rs",
    "src/subsystems/kernel.rs",
    "src/subsystems/media.rs",
    "src/subsystems/memory_monitor.rs",
    "src/subsystems/paravirtualization.rs",
    "src/subsystems/power.rs",
    "src/subsystems/radar.rs",
    "src/subsystems/rcs.rs",
    "src/subsystems/recovery.rs",
    "src/subsystems/sensors.rs",
    "src/subsystems/session.rs",
    "src/subsystems/setui.rs",
    "src/subsystems/starnix.rs",
    "src/subsystems/storage.rs",
    "src/subsystems/swd.rs",
    "src/subsystems/sysmem.rs",
    "src/subsystems/system_sounds.rs",
    "src/subsystems/tee.rs",
    "src/subsystems/thermal.rs",
    "src/subsystems/timekeeper.rs",
    "src/subsystems/trusted_apps.rs",
    "src/subsystems/ui.rs",
    "src/subsystems/usb.rs",
    "src/subsystems/virtualization.rs",
    "src/util.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.images2:fuchsia.images2_rust",
    "//sdk/fidl/fuchsia.sysmem2:fuchsia.sysmem2_rust",
    "//userspace/devices/bind/fuchsia.platform:fuchsia.platform_rust",
    "//userspace/diagnostics/lib/sampler-config",
    "//userspace/lib/assembly/cli_args",
    "//userspace/lib/assembly/component_id_index",
    "//userspace/lib/assembly/component_manager_config",
    "//userspace/lib/assembly/config_capabilities",
    "//userspace/lib/assembly/config_schema",
    "//userspace/lib/assembly/constants",
    "//userspace/lib/assembly/container",
    "//userspace/lib/assembly/images_config",
    "//userspace/lib/assembly/named_file_map",
    "//userspace/lib/assembly/platform_artifacts",
    "//userspace/lib/assembly/util",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-url",
    "//userspace/microfuchsia/tee/manager-config",
    "//userspace/starnix/lib/features:starnix_features",
    "//userspace/sys/lib/cm_config",
    "//userspace/sys/lib/cm_types",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:handlebars",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:serde_json5",
    "//third_party/rust_crates:uuid",
    "//tools/lib/cml",
  ]
  test_deps = [
    "//sdk/fidl/fuchsia.component.internal:fuchsia.component.internal_rust",
    "//userspace/lib/assembly/images_config",
    "//userspace/lib/assembly/util",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/utf8_path",
    "//third_party/rust_crates:tempfile",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}
