load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "package_utils",
    srcs = [
        "src/lib.rs",
        "src/package_utils.rs",
    ],
    crate_name = "assembly_package_utils",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    version = "0.1.0",
    visibility = [
        "//products/build/assembly/tools/generate_assembly_scrutiny_configs:__pkg__",
        "//userspace/lib/assembly:__subpackages__",
    ],
    # @bazel2gn:skip
    with_host_unit_tests = True,
    deps = [
        "//userspace/lib/assembly/util",
        "//userspace/sys/pkg/lib/fuchsia-pkg",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:schemars",
    ],
)
