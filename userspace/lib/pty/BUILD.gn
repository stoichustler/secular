import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":pty_tests" ]
}

rustc_library("pty") {
  with_unit_tests = true
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fdio/rust:fdio",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/trace/rust:trace",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:libc",
  ]

  test_deps = [
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
  ]

  sources = [
    "src/key_util.rs",
    "src/lib.rs",
    "src/pty.rs",
  ]
}

fuchsia_test_component("pty_tests_component") {
  component_name = "pty_tests"
  manifest = "meta/pty_tests.cml"
  deps = [
    ":pty_test",
    "//userspace/testing/zx-test-util:exit_with_code_util",
    "//userspace/zircon/bin/zxsh:sh",
  ]
}

fuchsia_test_package("pty_tests") {
  test_components = [ ":pty_tests_component" ]
  subpackages = [ "//userspace/secular/bin/ptysvc:package" ]
}
