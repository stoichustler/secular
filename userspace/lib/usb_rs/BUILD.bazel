load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "usb_rs",
    srcs = [
        "src/bulk_interface.rs",
        "src/lib.rs",
        "src/usb_linux/discovery.rs",
        "src/usb_linux/mod.rs",
        "src/usb_linux/usbdevice_fs.rs",
    ],
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    test_deps = [
        "//userspace/lib/fuchsia",
        "//third_party/rust_crates/vendor:tempfile",
    ],
    visibility = [
        ":__pkg__",
        "//userspace/developer/ffx/lib/usb_fastboot_discovery:__pkg__",
        "//userspace/developer/ffx/lib/usb_vsock_host:__pkg__",
        "//tools/zedmon/client:__pkg__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//userspace/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:libc",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:nix",
        "//third_party/rust_crates/vendor:notify",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
