import("//products/build/components.gni")
import("//products/build/testing/cc_test_executable.gni")

group("cobalt") {
  testonly = true
  deps = [
    ":cobalt_lib_tests",
    ":tests",
    ":unittests",
  ]
}

cc_test_executable("unittests") {
  testonly = true
  output_name = "cobalt_lib_unittests"

  deps = [
    "//userspace/lib/cobalt/cpp:unittests",
    "//userspace/lib/fxl/test:gtest_main",
  ]
}

fuchsia_unittest_component("cobalt_lib_unittests") {
  deps = [ ":unittests" ]
  manifest = "meta/cobalt_lib_unittests.cml"
}

fuchsia_test_package("cobalt_lib_tests") {
  test_components = [ ":cobalt_lib_unittests" ]
  test_specs = {
    log_settings = {
      max_severity = "FATAL"
    }
  }
}

group("tests") {
  testonly = true

  deps = [
    ":cobalt_lib_tests",
    "rust/builders:tests",
  ]
}
