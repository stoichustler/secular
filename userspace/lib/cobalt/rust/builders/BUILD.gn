    "//userspace/connectivity/location/emergency:*",
    "//userspace/connectivity/policy/reachability/core:*",
    "//userspace/power/power-manager:*",
    "//userspace/sys/pkg/bin/*",
    "//userspace/sys/time/httpsdate_time_source:*",
    "//userspace/sys/time/timekeeper:*",
    "//userspace/sys/time/timekeeper_integration:*",
  ]
  deps = [
    "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
    "//third_party/cobalt/src/lib/client/rust:cobalt-client",
  ]
}
