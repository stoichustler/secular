import("//products/build/bind/bind.gni")
import("//products/build/components.gni")
import("//products/build/drivers.gni")
import("//products/build/test.gni")

bind_library("testlib_bind") {
  source = "tests.bind"
  name = "testlib"
}

group("tests") {
  testonly = true
  deps = [
    ":ddktl-unittest-package",
    "metadata-server-test:tests",
  ]
}

group("drivers") {
  testonly = true
  deps = [ "metadata-server-test:drivers" ]
}

test("ddktl-test") {
  configs += [ "//products/build/config/fuchsia:enable_zircon_asserts" ]
  sources = [
    "composite-node-spec-tests.cc",
    "device-tests.cc",
    "ethernet-tests.cc",
  ]
  deps = [
    ":testlib_bind_cpp",
    "//examples/fidl/fuchsia.examples:fuchsia.examples_cpp",
    "//sdk/banjo/fuchsia.hardware.ethernet:fuchsia.hardware.ethernet_banjo_cpp",
    "//sdk/lib/fdio",
    "//userspace/devices/bind/fuchsia:fuchsia_cpp",
    "//userspace/devices/lib/driver",
    "//userspace/lib/ddk",
    "//userspace/lib/ddktl",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("ddktl-unittest-package") {
  package_name = "ddktl"
  deps = [ ":ddktl-test" ]
}
