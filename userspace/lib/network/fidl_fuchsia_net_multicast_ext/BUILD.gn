import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

rustc_library("fidl_fuchsia_net_multicast_ext") {
  with_unit_tests = true
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.net.multicast.admin:fuchsia.net.multicast.admin_rust",
    "//userspace/connectivity/lib/net-types",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/network/fidl_fuchsia_net_ext",
    "//third_party/rust_crates:futures",
  ]
  test_deps = [
    "//userspace/connectivity/lib/net-declare",
    "//third_party/rust_crates:test-case",
  ]

  sources = [ "src/lib.rs" ]

  configs += [ "//products/build/config/rust/lints:deny_unused_results" ]
}

fuchsia_unittest_package("fidl-fuchsia-net-multicast-ext-tests") {
  deps = [ ":fidl_fuchsia_net_multicast_ext_test" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":fidl-fuchsia-net-multicast-ext-tests",
    ":fidl_fuchsia_net_multicast_ext_test($host_toolchain)",
  ]
}
