load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/host_tests:host_rustc_test.bzl", "host_rustc_test")
load("//products/build/bazel/rules/rust:rustc_binary.bzl", "rustc_binary")

package(default_applicable_licenses = ["//:license"])

rustc_binary(
    name = "gcs_test_client_bin",
    testonly = True,
    srcs = ["src/main.rs"],
    crate_name = "gcs_test_client",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//userspace/lib/gcs:__pkg__"],
    deps = [
        "//userspace/lib/fuchsia-async",
        "//userspace/lib/fuchsia-hyper",
        "//userspace/lib/gcs",
        "//userspace/lib/structured_ui",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:http-body-util",
        "//third_party/rust_crates/vendor:hyper",
    ],
)

# @bazel2gn:skip
host_rustc_test(
    name = "gcs_test_client_bin_test",
    crate = ":gcs_test_client_bin",
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,
    visibility = ["//userspace/lib:__pkg__"],
)
