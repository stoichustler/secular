load("//products/build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "include_bytes_from_working_dir",
    srcs = ["src/lib.rs"],
    edition = "2024",
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//products/build/rust:__pkg__",  # @bazel2gn:raw_overwrite:"//userspace/lib/versioning/version-history/rust/proc-macro:*"
        "//userspace/lib/assembly/vbmeta:__pkg__",
        "//userspace/sys/component_manager:__pkg__",
        "//userspace/sys/pkg/lib/update-package:__pkg__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:syn",
    ],
)
