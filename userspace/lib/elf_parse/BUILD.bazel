load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "elf_parse",
    srcs = ["src/lib.rs"],
    compile_data = [
        "test-utils/elf_aarch64_file-header.bin",
        "test-utils/elf_riscv64_file-header.bin",
        "test-utils/elf_x86-64_file-header.bin",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:num-derive",
    ],
    visibility = [
        "//userspace/secular:__subpackages__",
        "//userspace/developer:__subpackages__",
        "//userspace/lib/elf-search/rust:__pkg__",
        "//userspace/lib/process_builder:__pkg__",
        "//userspace/performance:__subpackages__",
        "//userspace/starnix:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:num-traits",
        "//third_party/rust_crates/vendor:static_assertions",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
