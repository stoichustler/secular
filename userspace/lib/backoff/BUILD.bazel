load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//products/build/bazel/rules/cc:fx_cc_binary.bzl", "fx_cc_binary")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

cc_library(
    name = "backoff",
    srcs = ["exponential_backoff.cc"],
    hdrs = [
        "backoff.h",
        "exponential_backoff.h",
    ],
    visibility = [
        "//userspace/camera/lib/cobalt_logger:__pkg__",
        "//userspace/cobalt/bin/app:__pkg__",
        "//userspace/connectivity/weave/adaptation:__pkg__",
        "//userspace/developer/forensics:__subpackages__",
        "//userspace/devices/block/drivers/sdmmc:__pkg__",
        "//userspace/lib/backoff/testing:__pkg__",
        "//userspace/lib/fidl/contrib/connection:__pkg__",
    ],
    deps = [
        "//sdk/lib/fit",
        "//userspace/lib/fxl",
        "//zircon/system/ulib/zx",
    ],
    alwayslink = True,
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
fx_cc_binary(
    name = "backoff_unittests",
    testonly = True,
    srcs = ["exponential_backoff_unittest.cc"],
    tags = ["manual"],
    deps = [
        ":backoff",
        "//userspace/lib/fxl/test:gtest_main",
        "@com_google_googletest//:gtest",
    ],
)

# TODO(https://fxbug.dev/574121341): Run this test in GN too.
# @bazel2gn:skip
fx_unittest_package(
    name = "backoff_tests",
    package_name = "backoff_tests",
    unit_tests = [":backoff_unittests"],
    visibility = ["//userspace/lib:__pkg__"],
)
