{
    include: [
        "//userspace/lib/fuchsia-component-test/meta/nested_component_manager.shard.cml",
        "//userspace/sys/test_runners/rust/default.shard.cml",
        "sys/component/realm_builder.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "bin/fuchsia_component_test_tests_bin",
    },
    offer: [
        {
            storage: "data",
            from: "parent",
            to: [ "#realm_builder" ],
        },
    ],
}
