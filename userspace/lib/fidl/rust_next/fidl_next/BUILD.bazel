load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")
load("//products/build/rust:fidl_rust_next.bzl", "fidl_rust_next_allowlist")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fidl_next_internal",
    srcs = ["src/lib.rs"],
    crate_name = "fidl_next",
    edition = "2024",
    with_unit_tests = True,
    deps = [
        "//userspace/lib/fidl/rust_next/fidl_next_bind",
        "//userspace/lib/fidl/rust_next/fidl_next_codec",
        "//userspace/lib/fidl/rust_next/fidl_next_protocol",
        "//userspace/lib/fidl/rust_next/fidl_next_util",
    ],
)

alias(
    name = "fidl_next",
    actual = ":fidl_next_internal",
    visibility = fidl_rust_next_allowlist,
)
