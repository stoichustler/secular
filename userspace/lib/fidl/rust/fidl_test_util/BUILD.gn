import("//products/build/components.gni")
import("//products/build/fidl/fidl.gni")
import("//products/build/rust/rustc_library.gni")
import("//products/build/rust/rustc_test.gni")

rustc_library("fidl_test_util") {
  name = "fidl_test_util"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//userspace/lib/fdomain/client",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  test_deps = [
    "//userspace/lib/fdomain/local",
    "//userspace/lib/fuchsia",
    "//userspace/testing/fidl:placeholders_rust",
    "//userspace/testing/fidl:placeholders_rust_fdomain",
  ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package("fidl_test_util_target_test") {
  deps = [ ":fidl_test_util_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":fidl_test_util_target_test",
    ":fidl_test_util_test",
  ]
}
