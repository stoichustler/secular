load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# The unit tests (`:fidl-contrib_test` and `:fidl_contrib_rust_lib_tests`) stay
# in BUILD.gn because they use RealmBuilder via GN-only
# `//userspace/lib/fuchsia-component-test` (which packages
# `//userspace/lib/fuchsia-component-test/realm_builder_server:realm_builder_server_component`).
rustc_library(
    name = "fidl-contrib",
    srcs = [
        "src/lib.rs",
        "src/protocol_connector.rs",
    ],
    edition = "2024",
    visibility = [
        "//userspace/connectivity/location/emergency:__pkg__",
        "//userspace/power/power-manager:__pkg__",
        "//userspace/sys/pkg/bin:__subpackages__",
        "//userspace/sys/time/httpsdate_time_source:__pkg__",
        "//userspace/sys/time/timekeeper:__pkg__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//userspace/lib/fidl/rust/fidl",
        "//userspace/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
    ],
)
