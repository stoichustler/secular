import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

group("tests") {
  testonly = true

  deps = [ ":component_manager_util_test" ]
}

rustc_library("util") {
  edition = "2024"
  name = "cm_util"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fuchsia-fs",
    "//userspace/lib/fuchsia-sync",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:pin-project",
  ]

  test_deps = [ "//userspace/lib/fuchsia-async" ]

  sources = [
    "src/abortable_scope.rs",
    "src/channel.rs",
    "src/io.rs",
    "src/lib.rs",
  ]
}

fuchsia_unittest_package("component_manager_util_test") {
  deps = [ ":util_test" ]
}
