import("//products/build/component/config.gni")
import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/rust/rustc_test.gni")

group("tests") {
  testonly = true

  deps = [ ":ota-health-verification-test" ]
}

rustc_test("ota_health_verification_test_bin") {
  name = "ota_health_verification_test"
  edition = "2024"
  source_root = "integration_test.rs"
  deps = [
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/sys/lib/cm_rust",
    "//userspace/sys/lib/cm_types",
    "//userspace/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]

  sources = [ "integration_test.rs" ]
}

component_config("component_manager_config") {
  sources = [
    "//userspace/sys/component_manager/configs/no_debug.json5",
    "//userspace/sys/component_manager/configs/test_config.base.json5",
    "health_check.json5",
  ]
  dest = "data/component_manager_config"
}

fuchsia_component("component-manager-cmp") {
  testonly = true
  deps = [
    ":component_manager_config",
    "//userspace/sys/component_manager:bin_with_tracing",
  ]
  component_name = "component_manager"
  manifest = "//userspace/sys/component_manager/meta/component_manager.cml"
}

fuchsia_unittest_package("ota-health-verification-test") {
  manifest = "meta/integration_test.cml"
  deps = [
    ":component-manager-cmp",
    ":ota_health_verification_test_bin",
  ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
