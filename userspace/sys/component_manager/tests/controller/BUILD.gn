import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")

rustc_test("controller_integration_test_bin") {
  edition = "2024"
  testonly = true
  sources = [ "src/lib.rs" ]
  deps = [
    "//examples/components/routing/fidl:echo_rust",
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.runtime:fuchsia.component.runtime_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.process:fuchsia.process_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/lib/fuchsia-fs",
    "//userspace/lib/fuchsia-runtime",
    "//userspace/lib/fuchsia-sync",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//userspace/sys/lib/cm_rust",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:test-case",
  ]
}

fuchsia_unittest_package("controller_integration_test") {
  manifest = "meta/controller_integration_test.cml"
  deps = [
    ":controller_integration_test_bin",
    "//examples/components/routing/rust/echo_server:echo_server_cmp_for_nested_cm",
    "//userspace/sys/component_manager:component-manager-realm-builder-cmp",
  ]
}

group("tests") {
  testonly = true

  deps = [ ":controller_integration_test" ]
}
