load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# The unit tests (`:system-image_test`, `:system-image-test-component`, and
# `:system-image-tests`) stay in BUILD.gn because `system-image-test-component`
# packages `//userspace/storage/testing:storage_driver_test_realm`, and
# `:system-image_test` depends on `//userspace/sys/pkg/lib/fuchsia-pkg-testing` and
# `//userspace/sys/pkg/testing/blobfs-ramdisk` (which are GN-only and depend back on
# `:system-image`).
rustc_library(
    name = "system-image",
    srcs = [
        "src/anchored_packages.rs",
        "src/cache_packages.rs",
        "src/errors.rs",
        "src/lib.rs",
        "src/path_hash_mapping.rs",
        "src/system_image.rs",
    ],
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//userspace/sys/component_manager:__pkg__",
        "//userspace/sys/pkg:__subpackages__",
    ],
    deps = [
        "//userspace/lib/buf-read-ext",
        "//userspace/lib/collections/sorted-vec-map",
        "//userspace/lib/diagnostics/inspect/rust:fuchsia-inspect",  # @bazel2gn:path_overwrite://userspace/lib/diagnostics/inspect/rust
        "//userspace/lib/fuchsia-url",
        "//userspace/sys/pkg/lib/blobfs",
        "//userspace/sys/pkg/lib/fuchsia-hash",
        "//userspace/sys/pkg/lib/fuchsia-pkg",
        "//userspace/sys/pkg/lib/package-directory",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
