load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "context-authenticator",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//userspace/sys/component_manager:__pkg__",
        "//userspace/sys/pkg:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
        "//userspace/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:hmac",
        "//third_party/rust_crates/vendor:rand",
        "//third_party/rust_crates/vendor:sha2",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "context-authenticator_test",
    crate = ":context-authenticator",
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    deps = [
        "//userspace/lib/fuchsia",
        "//third_party/rust_crates/vendor:assert_matches",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "context-authenticator-tests",
    unit_tests = [":context-authenticator_test"],
)
