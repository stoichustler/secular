load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "fetch-url",
    srcs = [
        "src/errors.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    visibility = [
        "//userspace/sys/pkg/bin/pkgctl:__pkg__",
        "//userspace/sys/pkg/bin/system-updater:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.net.http:fuchsia.net.http_rust",
        "//userspace/lib/fidl/rust/fidl",
        "//userspace/lib/fuchsia-async",
        "//userspace/lib/fuchsia-component",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)
