import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# :package-directory_test depends on //userspace/sys/pkg/lib/fuchsia-pkg-testing,
# which is GN-only and depends on //userspace/sys/pkg/lib/system-image and
# //userspace/sys/pkg/lib/update-package (both of which depend back on
# :package-directory).
rustc_test("package-directory_test") {
  output_name = "package_directory_lib_test"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/rust/zx",
    "//userspace/lib/collections/packed",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-fs",
    "//userspace/lib/fuchsia-url",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//userspace/sys/pkg/lib/blobfs",
    "//userspace/sys/pkg/lib/far/rust:fuchsia-archive",
    "//userspace/sys/pkg/lib/fuchsia-hash",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//userspace/sys/pkg/lib/fuchsia-pkg-testing",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:pretty_assertions",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
  ]

  sources = [
    "src/lib.rs",
    "src/meta_as_dir.rs",
    "src/meta_subdir.rs",
    "src/non_meta_subdir.rs",
    "src/root_dir.rs",
    "src/root_dir_cache.rs",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("test-component") {
  component_name = "package-directory-lib-test"
  visibility = [ ":*" ]
  testonly = true
  deps = [ ":package-directory_test" ]
  manifest = "meta/package-directory-lib-test.cml"
}

fuchsia_test_package("package-directory-tests") {
  test_components = [ ":test-component" ]
}

group("tests") {
  testonly = true
  public_deps = [ ":package-directory-tests" ]
}

