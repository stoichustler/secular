load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "epoch",
    srcs = [
        "src/epoch.rs",
        "src/lib.rs",
    ],
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    visibility = [
        "//userspace/developer/ffx/plugins/assembly:__subpackages__",
        "//userspace/lib/assembly/product_bundle:__subpackages__",
        "//userspace/lib/assembly/update_package:__subpackages__",
        "//userspace/sys/pkg:__subpackages__",
    ],
    deps = [
        "//third_party/rust_crates/vendor:serde",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "epoch_test",
    crate = ":epoch",
    edition = "2024",
    lint_config = "//products/build/config/rust/lints:clippy_warn_all",
    deps = [
        "//third_party/rust_crates/vendor:proptest",
        "//third_party/rust_crates/vendor:serde_json",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "epoch-tests",
    unit_tests = [":epoch_test"],
)
