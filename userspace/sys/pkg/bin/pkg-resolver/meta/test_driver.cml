{
    include: [
        "//userspace/lib/fuchsia-hyper/hyper.shard.cml",
        "//userspace/storage/lib/fs_management/client.shard.cml",
        "//userspace/sys/test_runners/rust/default.shard.cml",
        "//userspace/sys/test_runners/tmp_storage.shard.cml",
        "inspect/client.shard.cml",
        "sys/component/realm_builder.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        binary: "bin/pkg_resolver_lib_test",
    },
    capabilities: [
        { protocol: "fuchsia.test.Suite" },
    ],
    use: [
        {
            protocol: [
                "fuchsia.net.http.Loader",
                "fuchsia.process.Launcher",
            ],
        },
    ],
}
