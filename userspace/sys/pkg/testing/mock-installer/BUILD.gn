import("//products/build/bazel/bazel_test_suite.gni")

bazel_test_suite("mock-installer-tests") {
  target_tests = [ "//userspace/sys/pkg/testing/mock-installer:mock-installer-tests" ]
}

bazel_test_suite("mock-installer_fdomain_test") {
  host_tests = [
    "//userspace/sys/pkg/testing/mock-installer:mock-installer_fdomain_host_test",
  ]
}

group("hermetic_tests") {
  testonly = true
  deps = [ ":mock-installer-tests" ]
}

group("host_tests") {
  testonly = true
  deps = [ ":mock-installer_fdomain_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":mock-installer-tests",
    ":mock-installer_fdomain_test",
  ]
}

