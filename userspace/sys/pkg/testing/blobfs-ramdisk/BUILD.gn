import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")
import("//userspace/storage/fshost/generated_fshost_config.gni")

# The library is defined in BUILD.bazel. Its unit tests stay in GN because
# test-component packages //userspace/storage/fxfs:fxfs_component and
# //userspace/storage/testing:storage_driver_test_realm, and :blobfs-ramdisk_test
# depends on //userspace/storage/blobfs/bin:blobfs-component.
rustc_test("blobfs-ramdisk_test") {
  output_name = "blobfs_ramdisk_lib_test"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.blobfs:fuchsia.storage.blobfs_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fdio/rust:fdio",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-fs",
    "//userspace/storage/blobfs/bin:blobfs-component",
    "//userspace/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
    "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//userspace/storage/lib/blob_writer:blob-writer",
    "//userspace/storage/lib/delivery_blob",
    "//userspace/storage/lib/fs_management/rust:fs_management",
    "//userspace/storage/lib/ramdevice_client",
    "//userspace/sys/pkg/lib/blobfs",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:openat",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/lib.rs",
    "src/test.rs",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
  rustenv = [ "FXFS_BLOB=${fxfs_blob}" ]
}

fuchsia_component("test-component") {
  testonly = true
  manifest = "meta/test_driver.cml"
  deps = [
    ":blobfs-ramdisk_test",
    "//userspace/storage/fxfs:fxfs_component",
    "//userspace/storage/testing:storage_driver_test_realm",
  ]
}

fuchsia_test_package("unit-tests-package") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  package_name = "blobfs-ramdisk-tests"
  test_components = [ ":test-component" ]
}

group("hermetic_tests") {
  testonly = true
  public_deps = [ ":unit-tests-package" ]
}

