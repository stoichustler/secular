import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")
import("//products/build/testing/environments.gni")

rustc_test("driver") {
  name = "pkg_cache_integration_test"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.boot:fuchsia.boot_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.resolution:fuchsia.component.resolution_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
    "//sdk/fidl/fuchsia.net.name:fuchsia.net.name_rust",
    "//sdk/fidl/fuchsia.paver:fuchsia.paver_rust",
    "//sdk/fidl/fuchsia.pkg:fuchsia.pkg_rust",
    "//sdk/fidl/fuchsia.pkg.garbagecollector:fuchsia.pkg.garbagecollector_rust",
    "//sdk/fidl/fuchsia.pkg.http:fuchsia.pkg.http_rust",
    "//sdk/fidl/fuchsia.pkg.internal:fuchsia.pkg.internal_rust",
    "//sdk/fidl/fuchsia.pkg.resolution:fuchsia.pkg.resolution_rust",
    "//sdk/fidl/fuchsia.posix.socket:fuchsia.posix.socket_rust",
    "//sdk/fidl/fuchsia.storage.blobfs:fuchsia.storage.blobfs_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_rust",
    "//sdk/fidl/fuchsia.update:fuchsia.update_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/hierarchy/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/lib/fuchsia-fs",
    "//userspace/lib/fuchsia-sync",
    "//userspace/storage/fidl/fuchsia.storage.mapping:fuchsia.storage.mapping_rust",
    "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//userspace/storage/lib/blob_writer:blob-writer",
    "//userspace/storage/lib/delivery_blob",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//userspace/sys/lib/cm_rust",
    "//userspace/sys/lib/fidl-fuchsia-pkg-ext",
    "//userspace/sys/lib/mem_util",
    "//userspace/sys/pkg/fidl/fuchsia.update.verify:fuchsia.update.verify_rust",
    "//userspace/sys/pkg/lib/blobfs",
    "//userspace/sys/pkg/lib/fuchsia-hash",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//userspace/sys/pkg/lib/fuchsia-pkg-testing",
    "//userspace/sys/pkg/lib/metrics:cobalt_sw_delivery_registry_rustlib",
    "//userspace/sys/pkg/lib/system-image",
    "//userspace/sys/pkg/testing/blobfs-ramdisk",
    "//userspace/sys/pkg/testing/mock-health-verification",
    "//userspace/sys/pkg/testing/mock-metrics",
    "//userspace/sys/pkg/testing/mock-paver",
    "//third_party/cobalt/src/lib/client/rust:cobalt-client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:http",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/base_pkg_index.rs",
    "src/base_resolver.rs",
    "src/cache_pkg_index.rs",
    "src/cobalt.rs",
    "src/driver_blob_paging.rs",
    "src/executability_enforcement.rs",
    "src/full_component_resolver.rs",
    "src/full_resolver.rs",
    "src/full_resolver_upgradable.rs",
    "src/get.rs",
    "src/inspect.rs",
    "src/lib.rs",
    "src/ota_downloader.rs",
    "src/ota_resolver.rs",
    "src/pkgfs.rs",
    "src/remote_resolver.rs",
    "src/remote_resolver_blobfs_errors.rs",
    "src/remote_resolver_recovers_from_http_errors.rs",
    "src/retained_blobs.rs",
    "src/retained_packages.rs",
    "src/space.rs",
    "src/sync.rs",
    "src/toolbox_resolver.rs",
    "src/write_blobs.rs",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("pkg-cache-integration-test") {
  testonly = true
  manifest = "meta/pkg-cache-integration-test.cml"
  deps = [
    ":driver",
    "//userspace/storage/fxfs:fxfs_component",
    "//userspace/storage/testing:storage_driver_test_realm",
  ]
}

resource("ca.cert-resource") {
  sources = [ "//userspace/sys/pkg/lib/fuchsia-pkg-testing/certs/ca.cert" ]
  outputs = [ "data/ssl/cert.pem" ]
}

fuchsia_test_package("pkg-cache-integration-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [ ":pkg-cache-integration-test" ]
  deps = [
    ":ca.cert-resource",
    "//userspace/connectivity/network/dns:component",
    "//userspace/connectivity/network/netstack3:component-for-tests",
    "//userspace/connectivity/policy/http-client:component",
    "//userspace/sys/pkg/bin/pkg-cache:component",
    "//userspace/sys/pkg/bin/system-update-committer:component",

    # TODO(https://fxbug.dev/540501441): Serve the blobs without the rest of the TUF repo.
    "//userspace/sys/pkg/tests/pkg-resolver:empty-repo",
  ]
}

group("hermetic_tests") {
  testonly = true
  if (!is_coverage) {
    # TODO(https://fxbug.dev/42158909): Re-enable this test when this test does
    # not timeout.
    public_deps = [ ":pkg-cache-integration-tests" ]
  }
}
