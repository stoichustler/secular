load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "fuchsia_package_resource_group",
    "resource",
)
load(
    "//products/build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
)

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:skip
fx_component_manifest(
    name = "pkg-resolver-manifest",
    component_name = "pkg-resolver",
    includes = [
        "//sdk/lib/inspect:client.shard.cml",
        "//sdk/lib/inspect:offer.shard.cml",
        "//sdk/lib/inspect:use.shard.cml",
        "//sdk/lib/syslog:client.shard",
        "//userspace/sys/pkg/bin/pkg-resolver:meta/pkg-resolver-common.shard.cml",
    ],
    manifest = "meta/pkg-resolver-for-test.cml",
)

# @bazel2gn:skip
resource(
    name = "ca.cert-resource",
    src = "//userspace/sys/pkg/lib/fuchsia-pkg-testing/certs:ca.cert",
    dest = "data/ssl/cert.pem",
)

# @bazel2gn:skip
fuchsia_package_resource_group(
    name = "empty-repo",
    testonly = True,
    srcs = [
        "//userspace/sys/pkg/tests/pkg-resolver/template:keys/root.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:keys/snapshot.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:keys/targets.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:keys/timestamp.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/1.root.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/1.snapshot.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/1.targets.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/root.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/snapshot.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/targets.json",
        "//userspace/sys/pkg/tests/pkg-resolver/template:repository/timestamp.json",
    ],
    dest = "empty-repo",
    strip_prefix = "template",
    visibility = [
        "//userspace/sys/pkg/bin/pkg-resolver:__pkg__",
        "//userspace/sys/pkg/lib/isolated-swd:__pkg__",
        "//userspace/sys/pkg/testing/isolated-ota-env:__pkg__",
        "//userspace/sys/pkg/tests/isolated-ota:__pkg__",
        "//userspace/sys/pkg/tests/pkg-cache:__pkg__",
    ],
)
