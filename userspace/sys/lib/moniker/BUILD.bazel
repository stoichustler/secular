load(
    "//products/build/bazel/rules/rust:defs.bzl",
    "rustc_library",
)

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "moniker",
    srcs = [
        "src/child_name.rs",
        "src/error.rs",
        "src/extended_moniker.rs",
        "src/lib.rs",
        "src/moniker.rs",
    ] + select({
        "//products/build/bazel/platforms:is_host_os": [
            "src/serde_ext.rs",
        ],
        "//conditions:default": [],
    }),
    crate_features = select({
        "//products/build/bazel/platforms:is_host_os": [
            "serde",
        ],
        "//conditions:default": [],
    }),
    crate_name = "moniker",
    edition = "2024",
    visibility = [
        "//:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//userspace/sys/lib/cm_rust",
        "//userspace/sys/lib/cm_types",
        "//third_party/rust_crates/vendor:flyweights",
        "//third_party/rust_crates/vendor:thiserror",
    ] + select({
        "//products/build/bazel/platforms:is_host_os": [
            "//third_party/rust_crates/vendor:schemars",
            "//third_party/rust_crates/vendor:serde",
        ],
        "//conditions:default": [],
    }),
)
