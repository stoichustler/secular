load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "bitflags-serde-legacy",
    srcs = ["src/lib.rs"],
    crate_name = "bitflags_serde_legacy",
    edition = "2024",
    test_deps = [
        "//third_party/rust_crates/vendor:bitflags",
        "//third_party/rust_crates/vendor:ciborium",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
    ],
    visibility = [
        "//userspace/settings/display:__pkg__",
        "//userspace/settings/input:__pkg__",
        "//userspace/settings/setup:__pkg__",
        "//userspace/sys/lib/bitflags-serde-legacy:__pkg__",
        "//userspace/sys/lib/cm_rust:__pkg__",
        "//visibility:private",
    ],
    with_unit_tests = True,
)
