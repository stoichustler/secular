load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "component-events",
    srcs = [
        "src/descriptor.rs",
        "src/events.rs",
        "src/lib.rs",
        "src/matcher.rs",
        "src/sequence.rs",
    ],
    edition = "2024",
    proc_macro_deps = [
        "//third_party/rust_crates/vendor:paste",
    ],
    visibility = [
        "//examples/components:__subpackages__",
        "//examples/fidl:__subpackages__",
        "//userspace/secular:__subpackages__",
        "//userspace/connectivity:__subpackages__",
        "//userspace/devices:__subpackages__",
        "//userspace/diagnostics:__subpackages__",
        "//userspace/lib/diagnostics/inspect/runtime/rust:__pkg__",
        "//userspace/lib/fuchsia-component-test:__subpackages__",
        "//userspace/starnix:__subpackages__",
        "//userspace/sys:__subpackages__",
        "//userspace/testing/sl4f:__pkg__",
        "//userspace/testing/system-validation:__pkg__",
        "//tools/fidl:__subpackages__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx",
        "//userspace/lib/fidl/rust/fidl",
        "//userspace/lib/fuchsia-component",
        "//userspace/sys/lib/moniker",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:pin-project-lite",
        "//third_party/rust_crates/vendor:regex-lite",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "component-events_test",
    crate = ":component-events",
    edition = "2024",
    deps = [
        "//userspace/lib/fuchsia",
        "//userspace/lib/fuchsia-async",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "component-events-unittests",
    unit_tests = [":component-events_test"],
)
