import("//products/build/components.gni")

executable("bin") {
  output_name = "tee-probe"

  sources = [ "tee-probe.cc" ]

  deps = [
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_cpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/fdio",
    "//userspace/zircon/lib/zircon",
    "//zircon/system/ulib/zx",
  ]
}

# GN-only Secular image: put the tool in /boot/bin.
group("bootfs_binaries") {
  visibility = [
    "//products/secular:*",
    "//userspace/zircon/bin:*",
  ]
  deps = [ ":bin" ]
}
