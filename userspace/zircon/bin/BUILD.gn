# GN-only Secular image: put the zircon CLI tools in /boot/bin.
# zxsh is packed separately as /boot/bin/sh.
group("bootfs_binaries") {
  visibility = [ "//products/secular:*" ]
  deps = [
    "hwstress:bootfs_binaries",
    "kcounter:bootfs_binaries",
    "ktrace:bootfs_binaries",
    "loadgen:bootfs_binaries",
    "pistress:bootfs_binaries",
    "tee-probe:bootfs_binaries",
    "time:bootfs_binaries",
    "uname:bootfs_binaries",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "hwstress:tests",
    "role_manager:tests",
    "zxsh:tests",
  ]
}
