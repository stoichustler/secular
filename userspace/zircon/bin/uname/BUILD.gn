import("//products/build/components.gni")

executable("bin") {
  output_name = "uname"

  sources = [ "uname.c" ]

  deps = [ "//userspace/zircon/lib/zircon" ]
}

fuchsia_package("uname") {
  deps = [ ":bin" ]
}

# GN-only Secular image: put the tool in /boot/bin.
group("bootfs_binaries") {
  visibility = [
    "//products/secular:*",
    "//userspace/zircon/bin:*",
  ]
  deps = [ ":bin" ]
}
