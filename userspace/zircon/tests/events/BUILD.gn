import("//products/build/components.gni")
import("//products/build/test.gni")

test("events") {
  output_name = "events-test"
  configs += [ "//products/build/config:all_source" ]
  sources = [ "events.c" ]
  deps = [
    "//sdk/lib/fdio",
    "//userspace/zircon/lib/zircon",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("events-test-pkg") {
  package_name = "events-test"
  deps = [ ":events" ]
}

group("tests") {
  testonly = true
  deps = [ ":events-test-pkg" ]
}
