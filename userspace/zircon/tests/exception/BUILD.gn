import("//products/build/components/fuchsia_unittest_package.gni")
import("//products/build/test.gni")
import("//products/build/testing/bootfs_test.gni")

group("tests") {
  testonly = true
  deps = [ ":exception-tests" ]
}

test("exception-test") {
  configs += [ "//products/build/config:all_source" ]
  sources = [
    "exception.cc",
    "exception_to_string.cc",
  ]
  deps = [
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/test-exceptions",
    "//zircon/system/ulib/test-utils",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("exception-tests") {
  manifest = "meta/exception-test.cml"
  deps = [ ":exception-test" ]
}

bootfs_test("exception-bootfs-test") {
  name = "exception-test"
  deps = [ ":exception-test" ]
}
