import("//products/build/components/fuchsia_unittest_package.gni")
import("//products/build/test.gni")

group("tests") {
  testonly = true
  if (current_cpu == "x64") {
    deps = [ ":x86-umip-test" ]
  }
}

test("x86-umip") {
  sources = [ "main.cc" ]
  deps = [
    "//userspace/lib/captive-thread/testing",
    "//userspace/lib/fxl/test:gtest_main",
    "//zircon/kernel/lib/arch",
  ]
}

fuchsia_unittest_package("x86-umip-test") {
  deps = [ ":x86-umip" ]
}
