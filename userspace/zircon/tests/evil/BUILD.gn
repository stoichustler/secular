import("//products/build/assembly/bootfs_files_for_assembly.gni")

executable("evil") {
  visibility = [ ":*" ]
  output_name = "evil-tests"
  sources = [ "evil.c" ]
  deps = [
    "//sdk/lib/fdio",
    "//userspace/zircon/lib/zircon",
  ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":evil" ]
}
