import("//products/build/components.gni")
import("//products/build/test.gni")

test("memfs-test") {
  sources = [ "memfs-tests.cc" ]
  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/fdio",
    "//sdk/lib/fidl/cpp/wire",
    "//sdk/lib/fit",
    "//userspace/lib/fxl/test:gtest_main",
    "//userspace/lib/testing/predicates",
    "//userspace/storage/lib/vfs/cpp",
    "//userspace/storage/memfs:lib",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zx",
  ]
}

fuchsia_unittest_package("memfs-tests") {
  deps = [ ":memfs-test" ]
}

test("memfs-legacy-test") {
  output_name = "memfs-legacy-test"
  sources = [
    "fidl-tests.cc",
    "vmofile-tests.cc",
  ]
  deps = [
    "//sdk/fidl/fuchsia.fs:fuchsia.fs_cpp",
    "//sdk/fidl/fuchsia.io:fuchsia.io_cpp",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_cpp",
    "//sdk/lib/async",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/fdio",
    "//sdk/lib/fdio-caller",
    "//sdk/lib/fidl/cpp/wire",
    "//sdk/lib/fit",
    "//userspace/storage/memfs:cpp",
    "//userspace/storage/memfs:lib",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/sync",
    "//zircon/system/ulib/zx",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("memfs-legacy-tests") {
  manifest = "meta/zircon-memfs-test.cml"
  deps = [ ":memfs-legacy-test" ]
  test_type = "system"
}

group("tests") {
  testonly = true
  deps = [
    ":memfs-legacy-tests",
    ":memfs-tests",
  ]
}
