load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

# Storage tests defined in Bazel. These are exported to `fx test` and infra
# builders through `:bazel_tests` in BUILD.gn.
test_suite(
    name = "target_tests",
    target_compatible_with = ["@platforms//os:fuchsia"],
    tests = [
        "//userspace/storage/fxfs/trace:fxfs-trace-tests-package",
        "//userspace/storage/lib/sparse/rust:sparse-test",
        "//userspace/storage/lib/units:storage-units-tests",
    ],
)

test_suite(
    name = "host_tests",
    target_compatible_with = HOST_CONSTRAINTS,
    tests = [
        "//userspace/storage/fxfs/trace:fxfs-trace-host-tests",
        "//userspace/storage/lib/sparse/rust:lib_test",
        "//userspace/storage/lib/units:units_host_test",
    ],
)
