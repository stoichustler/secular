# Console image storage: VFS servers + in-memory memfs.
# Disk filesystems (blobfs, fxfs, minfs, f2fs, fat, ext4, erofs) and
# fshost/fvm/gpt are not part of the Secular console product.

group("storage") {
  deps = [
    "lib",
    "memfs:lib",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "lib:tests",
    "memfs:tests",
  ]
}
