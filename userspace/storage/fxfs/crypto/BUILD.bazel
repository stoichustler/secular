load("//products/build/bazel/config/derived:compilation_modes.bzl", "is_debug")
load("//products/build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# @bazel2gn:raw_attribute:if (!is_debug) { configs -= [ "//products/build/config:default_optimize" ] configs += [ "//products/build/config:optimize_speed", "//products/build/config/lto:lto-if-compatible" ] }
rustc_library(
    name = "crypto",
    srcs = [
        "src/cipher.rs",
        "src/cipher/fscrypt_ino_lblk32.rs",
        "src/cipher/fscrypt_ino_lblk64.rs",
        "src/cipher/fscrypt_test_data.rs",
        "src/cipher/fxfs.rs",
        "src/ff1.rs",
        "src/lib.rs",
    ],
    crate_name = "fxfs_crypto",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:async-trait"],
    # Default optimizations are for size, but that has a noticeable impact on
    # speed.
    # TODO(https://fxbug.dev/571444250): Replace that with build_flags() labels.
    rustc_flags = [] if is_debug else [
        "-Copt-level=3",
    ],  # @bazel2gn:skip
    test_deps = [
        "//third_party/rust_crates/vendor:hex",
        "//third_party/rust_crates/vendor:rand",
    ],
    visibility = [
        "//userspace/storage/crypt/fxfs:__subpackages__",
        "//userspace/storage/crypt/starnix:__pkg__",
        "//userspace/storage/f2fs_reader/migrate:__pkg__",
        "//userspace/storage/fxfs:__subpackages__",
        "//userspace/storage/lib/block_server/vmo_backed:__pkg__",
        "//userspace/storage/lib/mapping:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//sdk/rust/zx-status",
        "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
        "//userspace/storage/fxfs/trace",
        "//userspace/storage/lib/fscrypt",
        "//userspace/storage/lib/ptr_slice",
        "//userspace/storage/lib/storage_xts",
        "//userspace/storage/type-fprint:fprint",
        "//third_party/rust_crates/vendor:aes",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:arbitrary",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:cbc",
        "//third_party/rust_crates/vendor:chacha20",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:siphasher",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
