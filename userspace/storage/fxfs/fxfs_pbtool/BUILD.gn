import("//products/build/bazel/bazel_inputs.gni")
import("//products/build/host.gni")
import("//products/build/rust/rustc_binary.gni")

assert(is_host, "fxfs_pbtool is only applicable on the host toolchain")

rustc_binary("fxfs_pbtool") {
  edition = "2024"

  sources = [ "src/main.rs" ]

  deps = [
    "//userspace/lib/fuchsia",
    "//userspace/storage/fxfs/make-blob-image",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
}

bazel_input_file("bazel_input") {
  generator = ":fxfs_pbtool"
  outputs = [ "${root_out_dir}/fxfs_pbtool" ]
}
