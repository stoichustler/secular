import("//products/build/components.gni")

# Generates a component with a storage-driver-test-realm.
template("storage_driver_test_realm_component") {
  fuchsia_unittest_component(target_name) {
    forward_variables_from(invoker, "*")
    deps += [
      "//userspace/storage/testing:storage_driver_test_realm",
      "//userspace/storage/testing:storage_test_includes",
    ]
  }
}
