import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")
import("//userspace/storage/testing/driver_test_realm.gni")

rustc_test("block_server_integration_tests") {
  edition = "2024"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.ramdisk:fuchsia.hardware.ramdisk_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component/client",
    "//userspace/storage/gpt/component:lib",
    "//userspace/storage/gpt/rust",
    "//userspace/storage/lib/block_client/rust",
    "//userspace/storage/lib/block_protocol",
    "//userspace/storage/lib/block_server",
    "//userspace/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
    "//userspace/storage/lib/fs_management/rust:fs_management",
    "//userspace/storage/lib/ramdevice_client/rust",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:test-case",
  ]
}

storage_driver_test_realm_component("block_server_integration_component") {
  deps = [ ":block_server_integration_tests" ]
}

fuchsia_test_package("block_server_integration") {
  test_components = [ ":block_server_integration_component" ]
}

group("tests") {
  testonly = true
  deps = [ ":block_server_integration" ]
}
