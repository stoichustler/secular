import("//products/build/tools/bazel2gn/bazel_migration.gni")

rustc_library("storage_xts") {
  sources = [ "src/lib.rs" ]
  edition = "2024"
  test_deps = [ "//third_party/rust_crates:test-case" ]
  visibility = [
    ":*",
    "//userspace/storage/fvm:*",
    "//userspace/storage/fxfs/crypto:*",
    "//vendor/google/*",
  ]
  with_unit_tests = true
  deps = [
    "//userspace/storage/lib/ptr_slice",
    "//third_party/rust_crates:cipher",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:zerocopy",
  ]
  if (!is_debug) {
    configs -= [ "//products/build/config:default_optimize" ]
    configs += [
      "//products/build/config:optimize_speed",
      "//products/build/config/lto:lto-if-compatible",
    ]
  }
}
