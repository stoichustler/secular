import("//products/build/components.gni")
import("//products/build/rust/rustc_test.gni")
import("//userspace/storage/testing/driver_test_realm.gni")

fuchsia_unittest_package("blob-writer-unittests") {
  deps = [ ":blob-writer_test" ]
}

rustc_test("blob-writer-test") {
  edition = "2024"
  deps = [
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
    "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//userspace/storage/lib/blob_writer:blob-writer",
    "//userspace/storage/lib/delivery_blob",
    "//userspace/storage/lib/fs_management/rust:fs_management",
    "//userspace/storage/lib/ramdevice_client/rust:ramdevice_client",
    "//userspace/sys/pkg/lib/fuchsia-merkle",
    "//third_party/rust_crates:rand",
  ]
  sources = [ "tests/lib.rs" ]
  source_root = "tests/lib.rs"
}

storage_driver_test_realm_component("blob-writer-test-component") {
  component_name = "blob-writer-test-component"
  manifest = "meta/blob_writer_test.cml"
  deps = [
    ":blob-writer-test",
    "//userspace/storage/fxfs:fxfs_component",
    "//userspace/storage/fxfs:test_fxfs_component_manifest_shard",
  ]
}

fuchsia_test_package("blob-writer-integration-tests") {
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
  test_components = [ ":blob-writer-test-component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":blob-writer-integration-tests",
    ":blob-writer-unittests",
  ]
}

