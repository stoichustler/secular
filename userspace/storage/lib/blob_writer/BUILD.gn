    "//third_party/rust_crates:assert_matches",
    "//third_party/rust_crates:rand",
  ]
  visibility = [
    ":*",
    "//userspace/connectivity/policy/http-client:*",
    "//userspace/storage/benchmarks/fuchsia:*",
    "//userspace/storage/fshost/integration:*",
    "//userspace/storage/fxfs/platform:*",
    "//userspace/storage/fxfs/test:*",
    "//userspace/storage/lib/fs_management/rust:*",
    "//userspace/storage/stress-tests/blobfs:*",
    "//userspace/sys/lib/fidl-fuchsia-pkg-ext:*",
    "//userspace/sys/pkg/testing/blobfs-ramdisk:*",
    "//userspace/sys/pkg/tests/pkg-cache:*",
  ]
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/storage/fxfs/fidl/fuchsia.fxfs:fuchsia.fxfs_rust",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:thiserror",
  ]
}
