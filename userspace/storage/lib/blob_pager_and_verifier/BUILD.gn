import("//products/build/components.gni")

# Keep the test package in GN with `parallel = 1` (which `fx_unittest_package`
# does not support yet) so concurrent test processes do not starve reader
# threads across 5ms pager timers under CQ test multiplication.
fuchsia_unittest_package("blob_pager_and_verifier_tests") {
  deps = [ ":blob_pager_and_verifier_test" ]
  test_specs = {
    parallel = 1
  }
}

group("tests") {
  testonly = true
  deps = [ ":blob_pager_and_verifier_tests" ]
}

