load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//products/build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "mapping",
    srcs = [
        "src/extents.rs",
        "src/file.rs",
        "src/lib.rs",
        "src/page_request.rs",
        "src/protocol.rs",
        "src/reader.rs",
        "src/testing.rs",
    ],
    edition = "2024",
    visibility = [
        "//userspace/devices/block/drivers/cqhci:__pkg__",
        "//userspace/storage:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//userspace/lib/fuchsia-sync",
        "//userspace/storage/fxfs/crypto",
        "//userspace/storage/lib/blob_metadata",
        "//userspace/storage/lib/delivery_blob",
        "//userspace/storage/lib/profile",
        "//userspace/storage/lib/ptr_slice",
        "//userspace/storage/lib/storage_device",
        "//userspace/storage/lib/vmo-fifo",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:bincode",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
rustc_test(
    name = "mapping_test",
    crate = ":mapping",
    edition = "2024",
    deps = [
        "//userspace/lib/fuchsia",
        "//userspace/lib/fuchsia-async",
    ],
)

# TODO(https://fxbug.dev/574121341): Run in GN too.
# @bazel2gn:skip
fx_unittest_package(
    name = "mapping-tests",
    max_log_severity = "ERROR",
    unit_tests = [":mapping_test"],
)
