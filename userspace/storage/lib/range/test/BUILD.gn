import("//products/build/components.gni")
import("//products/build/test.gni")

group("test") {
  testonly = true
  deps = [ ":range" ]
}

test("range") {
  sources = [
    "interval-tree-test.cc",
    "range.cc",
  ]
  deps = [
    "//sdk/lib/fdio",
    "//userspace/storage/lib/range",
    "//zircon/system/ulib/fbl",
    "//zircon/system/ulib/zxtest",
  ]
}

fuchsia_unittest_package("range-test-pkg") {
  package_name = "range"
  deps = [ ":range" ]
}

group("tests") {
  testonly = true
  deps = [ ":range-test-pkg" ]
}
