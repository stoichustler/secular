if (is_fuchsia) {
  rustc_library("block-client") {
    sources = [
      "src/cache.rs",
      "src/lib.rs",
    ]
    edition = "2024"
    visibility = [
      ":*",
      "//userspace/hypervisor/*",
      "//userspace/storage/lib/fs_management/rust:*",
      "//userspace/storage/lib/storage_device:*",
    ]
    deps = [
      "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
      "//sdk/rust/zx",
      "//userspace/lib/fidl/rust/fidl",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/fuchsia-sync",
      "//userspace/storage/lib/block_protocol",
      "//userspace/storage/lib/trace",
      "//third_party/rust_crates:anyhow",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:linked-hash-map",
      "//third_party/rust_crates:log",
    ]
  }
}
if (is_fuchsia) {
  rustc_library("fake-block-client") {
    sources = [ "src/fake_block_client.rs" ]
    source_root = "src/fake_block_client.rs"
    edition = "2024"
    visibility = [
      ":*",
      "//userspace/storage/fvm:*",
      "//userspace/storage/lib/storage_device:*",
      "//vendor/google/*",
    ]
    deps = [
      ":block-client",
      "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
      "//sdk/rust/zx",
      "//userspace/lib/fuchsia-sync",
    ]
  }
}
