load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load("//products/build/bazel/rules/testing:fx_unittest_package.bzl", "fx_unittest_package")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "profile",
    srcs = ["src/lib.rs"],
    crate_name = "storage_profile",
    edition = "2024",
    visibility = [
        "//userspace/storage/fxfs/platform:__pkg__",
        "//userspace/storage/fxfs/test:__pkg__",
        "//userspace/storage/lib:__subpackages__",
    ],
    deps = [
        "//sdk/rust/zx",
        "//userspace/storage/lib/ptr_slice",
        "//userspace/sys/pkg/lib/fuchsia-hash",
        "//third_party/rust_crates/vendor:arrayref",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "profile_test",
    crate = ":profile",
    edition = "2024",
    deps = ["//userspace/lib/fuchsia"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "storage-profile-tests",
    unit_tests = [":profile_test"],
)
