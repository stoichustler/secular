import("//products/build/assembly/bootfs_files_for_assembly.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("umount") {
  sources = [ "src/main.rs" ]
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.sys2:fuchsia.sys2_rust",
    "//sdk/lib/fdio",
    "//sdk/rust/zx",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/storage/fidl/fuchsia.fs.realm:fuchsia.fs.realm_rust",
    "//userspace/storage/lib/fs_management",
    "//userspace/sys/lib/component_debug",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//zircon/third_party/ulib/safemath",
  ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":umount" ]
}
