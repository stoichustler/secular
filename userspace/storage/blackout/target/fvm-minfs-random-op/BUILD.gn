import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

group("tests") {
  testonly = true
  deps = [ ":blackout-fvm-minfs-random-op" ]
}

rustc_binary("blackout-fvm-minfs-random-op-bin") {
  output_name = "blackout_fvm_bin"
  testonly = true
  edition = "2024"
  deps = [
    "//userspace/lib/fuchsia",
    "//userspace/storage/blackout/target/lib:blackout-target",
    "//userspace/storage/crypt/policy",
    "//userspace/storage/crypt/zxcrypt",
    "//userspace/storage/fidl/fuchsia.fs.startup:fuchsia.fs.startup_rust",
    "//userspace/storage/lib/fs_management/rust:fs_management",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:async-trait",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
  ]
  data_deps = [
    "//userspace/storage/fvm:fvm-component",
    "//userspace/storage/minfs/bin:minfs-component",
  ]
  sources = [ "src/main.rs" ]
}

fuchsia_component("blackout-fvm-minfs-random-op-component") {
  testonly = true
  deps = [ ":blackout-fvm-minfs-random-op-bin" ]
  manifest = "meta/blackout_fvm.cml"
}

fuchsia_package("blackout-fvm-minfs-random-op") {
  testonly = true
  deps = [ ":blackout-fvm-minfs-random-op-component" ]
}
