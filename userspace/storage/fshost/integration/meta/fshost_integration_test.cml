{
    include: [
        "//userspace/storage/lib/fs_management/client.shard.cml",
        "//userspace/storage/testing/meta/storage_test.shard.cml",
        "//userspace/sys/test_runners/rust/default.shard.cml",
        "driver_test_realm/realm_builder/client.shard.cml",
        "sys/component/realm_builder.shard.cml",
        "syslog/client.shard.cml",
    ],
    use: [
        {
            protocol: [
                "fuchsia.diagnostics.ArchiveAccessor",
                "fuchsia.process.Launcher",
            ],
        },
    ],
    offer: [
        {
            protocol: "fuchsia.process.Launcher",
            from: "parent",
            to: "#realm_builder",
        },
        {
            protocol: "fuchsia.scheduler.RoleManager",
            from: "void",
            to: "#fs-collection",
            availability: "optional",
        },
    ],
}
