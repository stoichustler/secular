import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [
    ":erofs-tests",
    "component:tests",
    "serializer:tests",
  ]
}

rustc_library("erofs") {
  name = "erofs"
  version = "0.1.0"
  with_unit_tests = true
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-sync",
    "//userspace/storage/lib/mapping",
    "//userspace/storage/lib/vmo-fifo",
    "//third_party/lz4/rust:lz4",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:crc",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:static_assertions",
    "//third_party/rust_crates:thiserror",
    "//third_party/rust_crates:zerocopy",
  ]

  test_deps = [
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/format.rs",
    "src/lib.rs",
    "src/mapper.rs",
    "src/readers.rs",
  ]
}

fuchsia_unittest_package("erofs-tests") {
  deps = [
    ":erofs_test",
    "testing:simple_erofs_image",
    "testing:simple_raw_files",
  ]
}
