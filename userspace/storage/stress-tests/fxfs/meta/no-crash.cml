{
    include: [
        "//userspace/storage/fs_test/meta/fxfs_crypt_test.shard.cml",
        "//userspace/storage/stress-tests/genericfs/meta/genericfs.shard.cml",
    ],
    program: {
        binary: "bin/fs_stressor",
        args: [
            // 6 hour time limit
            "--time-limit-secs",
            "21600",
            "--target-filesystem",
            "fxfs",
        ],
    },
}
