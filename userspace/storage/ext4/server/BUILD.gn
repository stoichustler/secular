import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/rust/rustc_test.gni")

rustc_binary("bin") {
  name = "ext4_server"
  edition = "2024"
  with_unit_tests = false
  source_root = "src/main.rs"

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-runtime",
    "//userspace/storage/ext4/lib/parser",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/main.rs" ]
}

rustc_test("ext4_server_integration_test") {
  source_root = "tests/ext4_server_test.rs"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.storage.block:fuchsia.storage.block_rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/lib/fuchsia-fs",
    "//userspace/storage/lib/block_server/vmo_backed:test_vmo_backed_block_server",
    "//userspace/storage/lib/vfs/rust:vfs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:hex",
    "//third_party/rust_crates:maplit",
    "//third_party/rust_crates:sha2",
    "//third_party/rust_crates:test-case",
  ]

  data_deps = [ ":bin" ]

  sources = [ "tests/ext4_server_test.rs" ]
}

fuchsia_component("ext4_server_comp") {
  component_name = "ext4_server"
  manifest = "meta/ext4.cml"
  deps = [ ":bin" ]
}

fuchsia_package("ext4_server_pkg") {
  package_name = "ext4_server"
  deps = [ ":ext4_server_comp" ]
}

fuchsia_component("ext4_readonly_comp") {
  component_name = "ext4_readonly"
  manifest = "meta/ext4_readonly.cml"
  deps = [ ":bin" ]
}

fuchsia_package("ext4_readonly_pkg") {
  package_name = "ext4_readonly"
  deps = [ ":ext4_readonly_comp" ]
}

fuchsia_unittest_component("ext4_server_integration_test_component") {
  component_name = "ext4_server_integration_test"
  deps = [ ":ext4_server_integration_test" ]
}

resource("ext4_server_integration_test_data") {
  testonly = true
  sources = [
    "../test_files/1file.img",
    "../test_files/extents.img",
    "../test_files/nest.img",
  ]
  outputs = [ "data/{{source_file_part}}" ]
}

fuchsia_test_package("ext4_server_integration_tests") {
  test_components = [ ":ext4_server_integration_test_component" ]
  deps = [
    ":ext4_readonly_comp",
    ":ext4_server_comp",
    ":ext4_server_integration_test_data",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":ext4_server_integration_tests" ]
}
