load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//products/build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "metadata",
    srcs = ["src/lib.rs"],
    crate_name = "ext4_metadata",
    edition = "2024",
    visibility = [
        "//userspace/starnix/kernel/core:__pkg__",
        "//userspace/starnix/lib/starnix_container:__pkg__",
        "//userspace/starnix/tools/tar_to_pkg:__pkg__",
        "//userspace/storage/benchmarks/starnix:__pkg__",
        "//userspace/storage/ext4/lib/ext4_extract:__pkg__",
        "//userspace/storage/ext4/tests:__pkg__",
        "//vendor/google:__subpackages__",
    ],
    deps = [
        "//userspace/lib/collections/sorted-vec-map",
        "//third_party/rust_crates/vendor:bincode",
        "//third_party/rust_crates/vendor:flyweights",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "metadata_test",
    crate = ":metadata",
    edition = "2024",
    deps = ["//third_party/rust_crates/vendor:assert_matches"],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "tests",
    package_name = "storage-ext4-metadata-tests",
    unit_tests = [":metadata_test"],
)
