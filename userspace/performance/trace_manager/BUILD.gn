import("//products/build/components.gni")

source_set("lib") {
  sources = [
    "buffer_forwarder.cc",
    "buffer_forwarder.h",
    "config.cc",
    "config.h",
    "deferred_buffer_forwarder.cc",
    "deferred_buffer_forwarder.h",
    "provider_connection.cc",
    "provider_connection.h",
    "shared_buffer.cc",
    "shared_buffer.h",
    "trace_manager.cc",
    "trace_manager.h",
    "trace_provider_bundle.cc",
    "trace_provider_bundle.h",
    "trace_session.cc",
    "trace_session.h",
    "tracee.cc",
    "tracee.h",
    "traceev2.cc",
    "traceev2.h",
    "util.cc",
    "util.h",
  ]

  deps = [
    "//sdk/lib/async-loop:async-loop-cpp",
    "//userspace/lib/fsl",
    "//third_party/rapidjson",
    "//zircon/system/ulib/trace-provider",
  ]

  public_deps = [
    "//sdk/fidl/fuchsia.sysinfo:fuchsia.sysinfo_cpp",
    "//sdk/fidl/fuchsia.tracing:fuchsia.tracing_cpp",
    "//sdk/fidl/fuchsia.tracing.controller:fuchsia.tracing.controller_cpp",
    "//sdk/fidl/fuchsia.tracing.provider:fuchsia.tracing.provider_cpp",
    "//sdk/lib/async:async-cpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/component/outgoing/cpp",
    "//sdk/lib/fit",
    "//userspace/lib/fxl:fxl_cli",
    "//zircon/system/ulib/trace-reader:trace-buffer-reader",
    "//zircon/system/ulib/zx",
  ]
}

executable("bin") {
  output_name = "trace_manager"

  sources = [ "main.cc" ]

  deps = [
    ":lib",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/syslog/cpp",
    "//userspace/lib/fxl",
  ]
}

resource("tracing.config") {
  sources = [ "tracing.config" ]
  outputs = [ "data/{{source_file_part}}" ]
}

# A version of trace manager that does not include the built in trace
# providers. Mainly used in tests which need tracing and use their own routed
# trace manager rather than the one in core.
fuchsia_component("component_hermetic") {
  component_name = "trace_manager"
  manifest = "meta/trace_manager_hermetic.cml"
  deps = [
    ":bin",
    ":tracing.config",
  ]
}

fuchsia_package("package_hermetic") {
  package_name = "trace_manager_hermetic"
  deps = [ ":component_hermetic" ]
}

fuchsia_package_with_single_component("trace_manager") {
  manifest = "meta/trace_manager.cml"
  component_name = "trace_manager"
  package_name = "trace_manager"
  deps = [
    ":bin",
    ":tracing.config",
  ]
  subpackages = [
    "//userspace/performance/ktrace_provider",
    "//userspace/performance/perfetto-bridge",
    "//userspace/performance/trace_session_manager",
  ]
  visibility = [
    ":*",
    "//products/bundles/assembly/*",
    "//products/bundles/assembly_input_groups/*",
  ]
}

group("trace_manager_pkg") {
  testonly = true
  deps = [ ":trace_manager" ]
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}
