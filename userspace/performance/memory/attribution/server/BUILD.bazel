load("//products/build/bazel/rules/rust:rustc_library.bzl", "rustc_library")
load("//products/build/bazel/rules/rust:rustc_test.bzl", "rustc_test")
load(
    "//products/build/bazel/rules/testing:fx_unittest_package.bzl",
    "fx_unittest_package",
)

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "server",
    srcs = [
        "src/attribution_server.rs",
        "src/lib.rs",
    ],
    crate_name = "attribution_server",
    edition = "2024",
    visibility = [
        "//examples/components/runner/colocated:__pkg__",
        "//userspace/devices/bin/driver_manager_rust/core:__pkg__",
        "//userspace/performance/memory/attribution/monitor:__pkg__",
        "//userspace/starnix/kernel/core:__pkg__",
        "//userspace/starnix/kernel/runner:__pkg__",
        "//userspace/sys/lib/elf_runner:__pkg__",
    ],
    deps = [
        "//sdk/fidl/fuchsia.memory.attribution:fuchsia.memory.attribution_rust",
        "//sdk/fidl/fuchsia.memory.attribution:measure_tape_for_attribution",
        "//sdk/rust/zx",
        "//userspace/lib/fidl/rust/fidl",
        "//userspace/lib/fuchsia-sync",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:thiserror",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "server_test",
    crate = ":server",
    edition = "2024",
    deps = [
        "//userspace/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:assert_matches",
        "//third_party/rust_crates/vendor:futures",
    ],
)

# @bazel2gn:skip
fx_unittest_package(
    name = "tests",
    package_name = "attribution-server-tests",
    unit_tests = [":server_test"],
)
