import("//products/build/components.gni")
import("//products/build/fidl/fidl.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_test("bin") {
  name = "system_activity_governor_controller_integration_test"
  testonly = true
  edition = "2024"
  deps = [
    "//sdk/fidl/fuchsia.power.observability:fuchsia.power.observability_rust",
    "//sdk/fidl/fuchsia.power.system:fuchsia.power.system_rust",
    "//sdk/fidl/fuchsia.power.topology.test:fuchsia.power.topology.test_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/reader/rust",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component-test",
    "//userspace/power/broker:component",
    "//userspace/power/system-activity-governor:component",
    "//userspace/power/system-activity-governor-controller:component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
  ]

  sources = [ "src/lib.rs" ]
}

fuchsia_unittest_package(
    "system-activity-governor-controller-integration-test") {
  manifest = "meta/test.cml"
  deps = [
    ":bin",
    "//userspace/power/testing/fake-shutdown-shim",
  ]
  test_specs = {
    environments = basic_envs
  }
  subpackages = [ "//userspace/power/system-activity-governor:config-no-suspender" ]
}

group("tests") {
  testonly = true
  deps = [ ":system-activity-governor-controller-integration-test" ]
}
