import("//products/build/components.gni")
import("//products/build/test.gni")

cc_test_executable("test") {
  testonly = true
  output_name = "mali_power_test"
  sources = [ "test.cc" ]
  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_cpp",
    "//sdk/fidl/fuchsia.driver.development:fuchsia.driver.development_cpp",
    "//sdk/fidl/fuchsia.driver.registrar:fuchsia.driver.registrar_cpp",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_cpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/diagnostics/reader/cpp:archive_reader",
    "//sdk/lib/driver/power/cpp",
    "//sdk/lib/fdio",
    "//userspace/graphics/drivers/msd-arm-mali/include",
    "//userspace/graphics/drivers/msd-arm-mali/tests/integration:mali_utils",
    "//userspace/graphics/lib/magma/src/libmagma",
    "//userspace/graphics/magma/lib/magma/util:macros",
    "//userspace/graphics/magma/lib/magma/util:short_macros",
    "//userspace/graphics/magma/lib/magma_client/test_util:magma_map_cpu",
    "//userspace/graphics/magma/lib/magma_client/test_util:test_device_helper",
    "//userspace/lib/fxl/test:gtest_main",
    "//userspace/lib/testing/loop_fixture",
    "//userspace/power/system-activity-governor/fake/fidl:test.sagcontrol_cpp",
    "//userspace/power/testing/system-integration/util",
  ]
}

fuchsia_test_component("component") {
  component_name = "mali_power_test_component"
  manifest = "meta/mali-power-test.cml"
  deps = [ ":test" ]
  test_type = "driver_system"
}

fuchsia_test_package("pkg") {
  package_name = "mali_power_test_pkg"
  test_components = [ ":component" ]
  deps = [ "//userspace/graphics/drivers/msd-arm-mali:msd_arm_test" ]
  test_specs = {
    environments = [ vim3_env ]
  }
}
