# This file was generated by the `fx create` command. The template
# is located at `//tools/create/templates/component-default/BUILD.gn.tmpl-rust`.
# If you find something broken, we are eager to review fixes.

import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

group("broker") {
  deps = [ ":package" ]
}

group("tests") {
  testonly = true
  deps = [
    ":power-broker-unittests",
    "client:tests",
    "tests/integration:tests",
  ]
}

fuchsia_component_manifest("manifest") {
  manifest = "meta/power_broker.cml"
  component_name = "power-broker"
}

fuchsia_structured_config_rust_lib("broker_config") {
  cm_label = ":manifest"
}

rustc_binary("bin") {
  output_name = "power-broker"
  edition = "2024"

  # Generates a GN target for unit-tests with the label `bin_test`, and
  # a binary named `power_broker_bin_test`.
  with_unit_tests = true

  configs += [ "//products/build/config/rust:bootfs" ]

  deps = [
    ":broker_config",
    "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//sdk/fidl/fuchsia.power.broker:fuchsia.power.broker_rust",
    "//sdk/rust/zx",
    "//userspace/lib/async-utils",
    "//userspace/lib/diagnostics/inspect/contrib/rust",
    "//userspace/lib/diagnostics/inspect/format/rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-sync",
    "//userspace/lib/trace/rust:trace",
    "//userspace/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:either",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:rand",
    "//third_party/rust_crates:rustc-hash",
  ]

  test_deps = [
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/power/broker/client",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/broker.rs",
    "src/credentials.rs",
    "src/inspect.rs",
    "src/main.rs",
    "src/topology.rs",
  ]
}

fuchsia_component("component") {
  cm_label = ":manifest"
  deps = [ ":bin" ]
}

fuchsia_package("package") {
  package_name = "power-broker"
  deps = [ ":component" ]
}

# Run with `fx test power-broker-unittests`.
fuchsia_unittest_package("power-broker-unittests") {
  deps = [ ":bin_test" ]
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
