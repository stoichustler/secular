import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("bin") {
  testonly = true
  output_name = "stop_watcher"
  edition = "2024"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  deps = [
    "../fidl:fuchsia.archivist.test_rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/sys/lib/component-events",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("stop-watcher-component") {
  testonly = true
  component_name = "stop_watcher"
  manifest = "meta/stop_watcher.cml"
  deps = [ ":bin" ]
}

fuchsia_package("stop_watcher") {
  testonly = true
  deps = [ ":stop-watcher-component" ]
}
