import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("bin") {
  testonly = true
  output_name = "archivist_test_puppet"
  edition = "2024"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  deps = [
    "../fidl:fuchsia.archivist.test_rust",
    "//sdk/fidl/fuchsia.diagnostics.types:fuchsia.diagnostics.types_rust",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/hierarchy/rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/inspect/rust/testing:inspect_testing",
    "//userspace/lib/diagnostics/log/encoding/rust",
    "//userspace/lib/diagnostics/log/rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fidl_table_validation",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("puppet-component") {
  testonly = true
  component_name = "puppet"
  manifest = "meta/puppet.cml"
  deps = [ ":bin" ]
}

fuchsia_package("puppet") {
  testonly = true
  deps = [ ":puppet-component" ]
}
