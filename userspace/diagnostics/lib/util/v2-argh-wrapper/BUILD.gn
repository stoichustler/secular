import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

rustc_library("v2-argh-wrapper") {
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  visibility = [ "//userspace/diagnostics/*" ]

  deps = [
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:log",
  ]

  test_deps = [ "//userspace/lib/fuchsia" ]

  sources = [ "src/lib.rs" ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

group("tests") {
  testonly = true
  deps = [ ":v2-argh-wrapper_test($host_toolchain)" ]
}
