import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

rustc_library("inspect-fetcher") {
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  visibility = [
    "//userspace/diagnostics/detect/*",
    "//userspace/diagnostics/lib/inspect-fetcher/*",
  ]

  deps = [
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//userspace/lib/diagnostics/reader/rust",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
  ]

  test_deps = [ "//userspace/lib/fuchsia" ]

  sources = [ "src/lib.rs" ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("inspect-fetcher-test") {
  deps = [ ":inspect-fetcher_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":inspect-fetcher-test" ]
}
