import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/testing/environments.gni")

rustc_binary("bin") {
  edition = "2024"
  name = "single_counter_bin"
  testonly = true
  deps = [
    "//userspace/diagnostics/sampler/tests/fidl:fuchsia.samplertestcontroller_rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-sync",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  sources = [ "src/main.rs" ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("single_counter_test_component") {
  testonly = true
  component_name = "single_counter_test_component"
  manifest = "meta/single-counter-test-component.cml"
  deps = [ ":bin" ]
}
