import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

# Library containing core logic for sampler,
# library launched by generic diagnostics Launcher
# to bundle multiple products together and save space.
rustc_library("lib") {
  name = "sampler"
  edition = "2024"
  with_unit_tests = true

  visibility = [
    "//userspace/diagnostics/launcher/*",
    "//userspace/diagnostics/sampler/*",
  ]

  deps = [
    ":sampler-component-config",
    "//sdk/fidl/fuchsia.diagnostics:fuchsia.diagnostics_rust",
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_rust",
    "//sdk/fidl/fuchsia.metrics:fuchsia.metrics_rust",
    "//sdk/rust/zx",
    "//userspace/diagnostics/lib/sampler-config",
    "//userspace/lib/diagnostics/data/rust",
    "//userspace/lib/diagnostics/hierarchy/rust",
    "//userspace/lib/diagnostics/inspect/contrib/rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/reader/rust",
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia-component/client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:thiserror",
  ]

  test_deps = [
    "//userspace/lib/diagnostics/selectors",
    "//userspace/lib/diagnostics/testing/diagnostics-assertions/rust:diagnostics-assertions",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-sync",
    "//third_party/rust_crates:assert_matches",
  ]

  sources = [
    "src/config.rs",
    "src/error.rs",
    "src/lib.rs",
    "src/project.rs",
  ]

  inputs = [
    "testing/realm-factory/configs/reboot_required_config.json",
    "testing/realm-factory/configs/test_config.json",
    "testing/realm-factory/configs/test_config_2.json",
  ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

# Test package for the unit test from the
# sampler library.
fuchsia_unittest_package("sampler-tests") {
  deps = [ ":lib_test" ]
}

# Rules defining the Sampler component.
fuchsia_component_manifest("sampler-manifest") {
  component_name = "sampler"
  manifest = "meta/sampler.cml"
}

fuchsia_component("sampler-component") {
  cm_label = ":sampler-manifest"
  deps = [ "//userspace/diagnostics/launcher:bin" ]
}

fuchsia_structured_config_rust_lib("sampler-component-config") {
  cm_label = ":sampler-manifest"
}

fuchsia_package("sampler") {
  deps = [ ":sampler-component" ]
}

group("tests") {
  testonly = true
  deps = [
    ":sampler-tests",
    "tests",
  ]
}
