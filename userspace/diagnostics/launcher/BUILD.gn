import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

launcher_sources = [ "src/main.rs" ]

launcher_deps = [
  "//userspace/diagnostics/detect:lib",
  "//userspace/diagnostics/lib/util/v2-argh-wrapper",
  "//userspace/diagnostics/persistence:lib",
  "//userspace/diagnostics/sampler:lib",
  "//userspace/lib/diagnostics/log/rust",
  "//userspace/lib/fuchsia",
  "//third_party/rust_crates:anyhow",
  "//third_party/rust_crates:argh",
]

rustc_binary("bin") {
  name = "launcher"
  edition = "2024"

  deps = launcher_deps

  sources = launcher_sources

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

# The Detect integration test needs a "with fake time" version of Launcher.

rustc_binary("bin_with_fake_time") {
  testonly = true
  name = "launcher_with_fake_time"
  edition = "2024"

  deps = launcher_deps

  sources = launcher_sources

  non_rust_deps = [ "//userspace/lib/fake-clock/lib" ]

  visibility = [ "//userspace/diagnostics/detect/integration/target:*" ]

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

group("launcher") {
  deps = [ ":bin" ]
}
