import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("bin") {
  testonly = true
  name = "iquery_test_component"
  edition = "2024"
  source_root = "main.rs"
  sources = [ "main.rs" ]
  deps = [
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/inspect/rust/testing:inspect_testing",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:clap",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("test_component") {
  testonly = true
  manifest = "meta/test_component.cml"
  deps = [ ":bin" ]
}
