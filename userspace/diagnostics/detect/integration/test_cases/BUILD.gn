import("//products/build/component/config.gni")
import("//products/build/components.gni")
import("//products/build/fidl/fidl.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_test("bin") {
  testonly = true
  edition = "2024"
  source_root = "src/main.rs"
  name = "diagnostics_detect_test_cases_bin"
  deps = [
    "../realm_factory/fidl/test.detect.factory:fidl_rust",
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.testing.harness:fuchsia.testing.harness_rust",

    # fake-clock/fidl defines library fuchsia.testing, unrelated to
    # fuchsia.testing.harness.
    "//sdk/rust/zx",
    "//userspace/lib/fake-clock/fidl:fidl_rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//userspace/testing/realm_proxy/client",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
    "//third_party/rust_crates:test-case",
  ]

  sources = [
    "src/main.rs",
    "src/test_filing_enable.rs",
    "src/test_snapshot_sanitizing.rs",
    "src/test_snapshot_throttle.rs",
    "src/test_trigger_truth.rs",
  ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_component("component") {
  testonly = true
  component_name = "test_cases"
  manifest = "meta/test_cases.cml"
  deps = [ ":bin" ]
}

fuchsia_package("pkg") {
  testonly = true
  package_name = "diagnostics_detect_test_cases"
  deps = [ ":component" ]
}
