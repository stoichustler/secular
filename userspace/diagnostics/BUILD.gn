import("//products/build/bazel/bazel_test_suite.gni")

group("diagnostics") {
  testonly = true
  deps = [
    ":tests",
    "archivist",
    "archivist:build-only",
    "config",
    "iquery",
    "tools($host_toolchain)",

    # contains persistence, sampler, and detect
    "launcher",
    "log_listener",
    "triage",
    "validator",
    "//examples/diagnostics",
    "//userspace/lib/diagnostics",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "archivist:build-only",
    "archivist:tests",
    "config:tests",
    "detect:tests",
    "iquery:tests",
    "lib:tests",
    "log_listener:tests",
    "persistence:tests",
    "sampler:tests",
    "tests",
    "tools:tests($host_toolchain)",
    "triage:tests",
    "validator:tests",
    "//examples/diagnostics:hermetic_tests",
    "//sdk/lib/diagnostics:tests",
    "//sdk/lib/inspect:tests",
    "//sdk/lib/syslog:tests",
    "//userspace/developer/ffx/plugins/inspect:tests($host_toolchain)",
    "//userspace/developer/ffx/plugins/log:tests($host_toolchain)",
    "//userspace/developer/ffx/tools/triage:tests($host_toolchain)",
    "//userspace/lib/diagnostics:tests",
  ]
}

# Diagnostics device tests defined in Bazel. See //userspace/diagnostics/BUILD.bazel.
bazel_test_suite("bazel_tests") {
  target_tests = [ "//userspace/diagnostics:target_tests" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "archivist:benchmarks",
    "//userspace/lib/diagnostics:benchmarks",
  ]
}
