import("//products/build/components.gni")
import("//products/build/dist/resource.gni")
import("//products/build/testing/cc_test_executable.gni")

group("packages") {
  deps = [ ":guest_manager" ]
}

group("tests") {
  testonly = true
  deps = [ ":guest_manager_test" ]
}

source_set("lib") {
  visibility = [ "//userspace/hypervisor/*" ]

  sources = [
    "guest_manager.cc",
    "guest_manager.h",
    "memory_pressure_handler.cc",
    "memory_pressure_handler.h",
  ]

  deps = [ "//zircon/system/ulib/virtio" ]
  public_deps = [
    "//sdk/fidl/fuchsia.memorypressure:fuchsia.memorypressure_cpp",
    "//sdk/fidl/fuchsia.net.interfaces:fuchsia.net.interfaces_hlcpp",
    "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_cpp",
    "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_hlcpp",
    "//sdk/lib/component/incoming/cpp",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
    "//userspace/lib/fxl",
    "//userspace/hypervisor/lib/guest_config",
    "//zircon/system/ulib/bitmap",
  ]

  if (!defined(public_configs)) {
    public_configs = []
  }
  public_configs += [ "//userspace/hypervisor/bin:args" ]
}

executable("bin") {
  output_name = "guest_manager"

  sources = [ "guest_manager_main.cc" ]

  deps = [
    ":lib",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
  ]
}

resource("rtos_cfg") {
  sources = [ "data/rtos.cfg" ]
  outputs = [ "data/rtos.cfg" ]
}

resource("secular_zephyr_bin") {
  sources = [ "//products/prebuilt/rtos/zephyr.bin" ]
  outputs = [ "data/zephyr.bin" ]
}

resource("secular_linux_cfg") {
  sources = [ "data/linux.cfg" ]
  outputs = [ "data/linux.cfg" ]
}

resource("secular_linux_image") {
  sources = [ "//products/prebuilt/linux/Image" ]
  outputs = [ "data/Image" ]
}

resource("secular_linux_minifs") {
  sources = [ "//products/prebuilt/linux/minifs.cpio" ]
  outputs = [ "data/minifs.cpio" ]
}

fuchsia_component("guest_pkg") {
  component_name = "guest_pkg"
  manifest = "meta/guest_pkg.cml"

  # Nested into the guest_manager package. Skip cmc check-includes
  # (CML shards expected by library deps) and cmc validate-references
  # (program.binary vs package files). `gn gen` prints
  # "Not validated: <this label>"; the compiled .cm is still packaged.
  check_includes = false
  check_references = false
  deps = [
    ":rtos_cfg",
    ":secular_linux_cfg",
    ":secular_linux_image",
    ":secular_linux_minifs",
    ":secular_zephyr_bin",
    "//userspace/hypervisor/packages:guest_package_bin",
  ]
}

fuchsia_component("guest_manager_cmp") {
  component_name = "guest_manager"
  manifest = "meta/guest_manager.cml"

  # Skip cmc check-includes / validate-references. `gn gen` prints
  # "Not validated: <this label>"; the compiled .cm is still packaged.
  check_includes = false
  check_references = false
  deps = [
    ":bin",
    ":guest_pkg",
  ]
}

fuchsia_package("guest_manager") {
  package_name = "guest_manager"
  deps = [ ":guest_manager_cmp" ]
}

cc_test_executable("guest_manager_test_bin") {
  testonly = true

  sources = [
    "guest_manager_test.cc",
    "memory_pressure_handler_test.cc",
  ]

  deps = [
    ":lib",
    "//sdk/fidl/fuchsia.memorypressure:fuchsia.memorypressure_hlcpp",
    "//sdk/fidl/fuchsia.virtualization.hardware:fuchsia.virtualization.hardware_hlcpp",
    "//sdk/lib/sys/cpp/testing:unit",
    "//sdk/lib/syslog/cpp",
    "//userspace/lib/fxl/test:gtest_main",
    "//userspace/lib/testing/loop_fixture",
    "//userspace/testing/fidl:placeholders_hlcpp",
    "//zircon/system/ulib/virtio",
  ]
}

resource("test_configs") {
  sources = [
    "test_files/bad_schema_invalid_field.cfg",
    "test_files/valid_guest.cfg",
  ]

  outputs = [ "data/configs/{{source_file_part}}" ]
}

fuchsia_unittest_package("guest_manager_test") {
  deps = [
    ":guest_manager_test_bin",
    ":test_configs",
  ]

  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
