// Placeholder guest package: serves /pkg (data/guest.cfg) without a
// kernel image so guest_manager can start.
{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/guest_package",
    },
    capabilities: [
        {
            directory: "pkg",
            rights: [ "r*" ],
            path: "/pkg",
        },
    ],
    expose: [
        {
            directory: "pkg",
            from: "self",
        },
    ],
}
