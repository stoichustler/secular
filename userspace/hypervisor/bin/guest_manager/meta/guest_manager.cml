// Unified guest manager for Secular. One component launches Linux and RTOS
// guests through fuchsia.virtualization.GuestManager. Each vmid connects to
// GuestLifecycle (provided by vmm_launcher), which starts a dedicated VMM.
// GPU, audio, and net virtio devices are not routed.
{
    include: [
        "inspect/offer.shard.cml",
        "syslog/client.shard.cml",
        "trace/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/guest_manager",
    },
    children: [
        {
            name: "guest_pkg",
            url: "#meta/guest_pkg.cm",
        },
    ],
    capabilities: [
        {
            protocol: [ "fuchsia.virtualization.GuestManager" ],
        },
    ],
    use: [
        {
            directory: "pkg",
            from: "#guest_pkg",
            rights: [ "r*" ],
            path: "/guest_pkg",
        },
        {
            protocol: [ "fuchsia.virtualization.GuestLifecycle" ],
        },
        {
            protocol: [ "fuchsia.memorypressure.Provider" ],
            availability: "optional",
        },
    ],
    offer: [
        {
            dictionary: "diagnostics",
            from: "parent",
            to: [ "#guest_pkg" ],
        },
    ],
    expose: [
        {
            protocol: "fuchsia.virtualization.GuestManager",
            from: "self",
        },
    ],
}
