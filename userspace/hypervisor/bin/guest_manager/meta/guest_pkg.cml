// Guest package: data/guest.cfg + data/zephyr.bin (vmid 0 RTOS),
// data/linux.cfg + data/Image + data/minifs.cpio (vmid 1 Linux).
{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/guest_package",
    },
    capabilities: [
        {
            directory: "pkg",
            rights: [ "r*" ],
            path: "/pkg",
        },
    ],
    expose: [
        {
            directory: "pkg",
            from: "self",
        },
    ],
}
