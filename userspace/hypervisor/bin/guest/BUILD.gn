import("//products/build/assembly/bootfs_files_for_assembly.gni")
import("//products/build/components.gni")
import("//products/build/dist/renamed_binary.gni")
import("//products/build/rust/rustc_binary.gni")

group("guest") {
  deps = [ ":guest_package" ]
}

group("tests") {
  testonly = true
  deps = [ ":guest_tests" ]
}

rustc_binary("bin") {
  edition = "2024"
  output_name = "guest"
  configs += [ "//products/build/config/rust:bootfs" ]
  deps = [
    "//userspace/lib/fuchsia",
    "//userspace/hypervisor/lib/cli:guest_cli",
    "//userspace/hypervisor/lib/cli/args:guest_cli_args",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]

  with_unit_tests = true

  sources = [ "src/main.rs" ]
}

fuchsia_unittest_package("guest_tests") {
  deps = [ ":bin_test" ]
}

fuchsia_package("guest_package") {
  package_name = "guest"
  deps = [ ":bin" ]
}

renamed_binary("bootfs_guest") {
  source = "$root_out_dir/guest"
  source_deps = [ ":bin" ]
  dest = "bin/guest"
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":bootfs_guest" ]
}
