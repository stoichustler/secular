import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/rust/rustc_test.gni")

group("tests") {
  testonly = true
  deps = [ ":vmm_launcher_tests" ]
}

fuchsia_component_manifest("manifest") {
  component_name = "vmm_launcher"
  manifest = "meta/vmm_launcher.cml"
}

fuchsia_structured_config_rust_lib("vmm_launcher_config") {
  cm_label = ":manifest"
}

rustc_binary("vmm_launcher_bin") {
  edition = "2024"
  name = "vmm_launcher"
  configs += [ "//products/build/config/rust:bootfs" ]

  sources = [
    "src/main.rs",
    "src/vmm_launcher.rs",
  ]

  deps = [
    ":vmm_launcher_config",
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_rust",
    "//sdk/rust/zx-status",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

rustc_test("vmm_launcher_test_bin") {
  edition = "2024"
  source_root = "tests/integration.rs"
  sources = [ "tests/integration.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.component:fuchsia.component_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_rust",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fuchsia",
    "//userspace/lib/fuchsia-component-test",
    "//third_party/rust_crates:anyhow",
  ]
}

fuchsia_test_component("vmm_launcher_tests_component") {
  component_name = "vmm_launcher_tests"
  manifest = "meta/vmm_launcher_tests.cml"
  deps = [
    ":vmm_launcher",
    ":vmm_launcher_test_bin",
  ]
  test_type = "system"
}

fuchsia_test_package("vmm_launcher_tests") {
  test_components = [ ":vmm_launcher_tests_component" ]
  deps = [ ":vmm_launcher_component" ]
}

fuchsia_component("vmm_launcher_component") {
  cm_label = ":manifest"

  # Skip cmc check-includes / validate-references. `gn gen` prints
  # "Not validated: <this label>"; the compiled .cm is still packaged.
  check_includes = false
  check_references = false
  deps = [
    ":vmm_launcher_bin",
    "//userspace/hypervisor/bin/vmm:vmm_component",
  ]
}

fuchsia_package("vmm_launcher") {
  package_name = "vmm_launcher"
  deps = [ ":vmm_launcher_component" ]
}
