import("//userspace/developer/ffx/build/ffx_plugin.gni")
import("//userspace/developer/ffx/build/ffx_tool.gni")

ffx_plugin("ffx_guest") {
  version = "0.1.0"
  edition = "2024"

  plugin_deps = [
    "attach:ffx_guest_attach",
    "launch:ffx_guest_launch",
    "list:ffx_guest_list",
    "stop:ffx_guest_stop",
  ]
  args_sources = [ "src/args.rs" ]
}

ffx_tool("ffx_guest_tool") {
  edition = "2024"
  output_name = "ffx-guest"
  deps = [
    ":ffx_guest_suite",
    "//userspace/lib/fuchsia",
  ]
  sources = [ "src/main.rs" ]
}
