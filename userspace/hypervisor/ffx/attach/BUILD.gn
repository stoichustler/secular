import("//userspace/developer/ffx/build/ffx_plugin.gni")

ffx_plugin("ffx_guest_attach") {
  version = "0.1.0"
  edition = "2024"

  args_sources = [ "src/args.rs" ]
  args_deps = [ "//userspace/hypervisor/lib/cli/args:guest_cli_args" ]

  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.developer.remotecontrol:fuchsia.developer.remotecontrol_rust",
    "//userspace/developer/ffx/lib/fho:lib",
    "//userspace/hypervisor/lib/cli:guest_cli",
    "//third_party/rust_crates:async-trait",
  ]
}
