import("//products/build/rust/rustc_binary.gni")

rustc_binary("tipc") {
  output_name = "tipc"
  edition = "2024"
  source_root = "src/main.rs"
  sources = [ "src/main.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  deps = [ "//userspace/secular/lib/cfg" ]
  if (is_fuchsia) {
    deps += [
      "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
      "//sdk/rust/zx",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/fuchsia-component",
      "//userspace/lib/fuchsia-runtime",
      "//third_party/rust_crates:anyhow",
    ]
  }
  with_unit_tests = true
}
