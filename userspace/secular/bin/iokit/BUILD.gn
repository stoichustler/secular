import("//products/build/rust/rustc_binary.gni")

rustc_binary("cat") {
  output_name = "cat"
  edition = "2024"
  source_root = "src/cat.rs"
  sources = [ "src/cat.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("tree") {
  output_name = "tree"
  edition = "2024"
  source_root = "src/tree.rs"
  sources = [ "src/tree.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("clear") {
  output_name = "clear"
  edition = "2024"
  source_root = "src/clear.rs"
  sources = [ "src/clear.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

group("iokit") {
  deps = [
    ":cat",
    ":clear",
    ":tree",
  ]
}
