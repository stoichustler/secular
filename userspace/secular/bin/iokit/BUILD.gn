import("//products/build/rust/rustc_binary.gni")

rustc_binary("bootstat") {
  output_name = "bootstat"
  edition = "2024"
  source_root = "src/bootstat.rs"
  sources = [ "src/bootstat.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  if (is_fuchsia) {
    deps = [ "//sdk/rust/zx-sys" ]
  }
  with_unit_tests = true
}

rustc_binary("cat") {
  output_name = "cat"
  edition = "2024"
  source_root = "src/cat.rs"
  sources = [ "src/cat.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("clear") {
  output_name = "clear"
  edition = "2024"
  source_root = "src/clear.rs"
  sources = [ "src/clear.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("elfdump") {
  output_name = "elfdump"
  edition = "2024"
  source_root = "src/elfdump.rs"
  sources = [ "src/elfdump.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("hexdump") {
  output_name = "hexdump"
  edition = "2024"
  source_root = "src/hexdump.rs"
  sources = [ "src/hexdump.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("cpustat") {
  output_name = "cpustat"
  edition = "2024"
  source_root = "src/cpustat.rs"
  sources = [ "src/cpustat.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  if (is_fuchsia) {
    deps = [
      "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
      "//sdk/rust/zx",
      "//sdk/rust/zx-sys",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/fuchsia-component",
    ]
  }
  with_unit_tests = true
}

rustc_binary("kdmips") {
  output_name = "kdmips"
  edition = "2024"
  source_root = "src/kdmips.rs"
  sources = [ "src/kdmips.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

rustc_binary("tree") {
  output_name = "tree"
  edition = "2024"
  source_root = "src/tree.rs"
  sources = [ "src/tree.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  with_unit_tests = true
}

group("iokit") {
  deps = [
    ":bootstat",
    ":cat",
    ":clear",
    ":cpustat",
    ":elfdump",
    ":hexdump",
    ":kdmips",
    ":tree",
  ]
}
