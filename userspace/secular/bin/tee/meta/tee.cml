// Software TEE realm for Secular. Binder-proxy (Android host / vsock) is
// omitted until virtio vsock is available.
{
    include: [ "//userspace/secular/bin/tee/manager/meta/ta-manager-realm.shard.cml" ],
    children: [
        {
            name: "ta-manager",
            url: "fuchsia-boot:///ta-manager#meta/ta-manager.cm",
        },
        {
            name: "ta-manager-config",
            url: "fuchsia-boot:///ta-manager-config#meta/ta-manager-config.cm",
        },
    ],
    offer: [
        {
            dictionary: "diagnostics",
            from: "parent",
            to: [ "#ta-manager-config" ],
        },
    ],
}
