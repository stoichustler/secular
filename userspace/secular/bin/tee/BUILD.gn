import("//products/build/components/fuchsia_component.gni")
import("//products/build/components/fuchsia_package.gni")

group("tests") {
  testonly = true
  deps = [
    "lib:tests",
    "manager:tests",
    "runtime:tests",
    "ta:tests",
    "tee_internal_api:tests",
  ]
}

fuchsia_component("tee-component") {
  manifest = "meta/tee.cml"
  component_name = "tee"
}

fuchsia_package("tee") {
  deps = [ ":tee-component" ]

  # Keep the TA runtime and sample TA in the product graph even though they
  # are instantiated from TA packages rather than this realm package.
  data_deps = [
    "runtime:runtime",
    "ta/noop:ta-noop",
  ]
}
