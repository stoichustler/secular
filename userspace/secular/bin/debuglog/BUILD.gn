import("//products/build/assembly/bootfs_files_for_assembly.gni")

executable("debuglog") {
  sources = [ "debuglog.cc" ]
  deps = [
    "//sdk/lib/fdio",
    "//zircon/system/ulib/zx",
  ]
}

# GN-only Secular image: put the tool in /boot/bin.
group("bootfs_binaries") {
  visibility = [ "//products/secular:*" ]
  deps = [ ":debuglog" ]
}

bootfs_files_for_assembly("bootfs") {
  deps = [ ":debuglog" ]
}
