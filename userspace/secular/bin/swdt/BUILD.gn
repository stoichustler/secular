import("//products/build/components.gni")
import("//products/build/rust/rustc_binary.gni")

rustc_binary("swdt") {
  output_name = "swdt"
  edition = "2024"
  source_root = "swdt.rs"
  sources = [ "swdt.rs" ]
  configs += [ "//products/build/config/rust:bootfs" ]
  if (is_fuchsia) {
    deps = [
      "//sdk/fidl/fuchsia.virtualization:fuchsia.virtualization_rust",
      "//userspace/lib/fuchsia-async",
      "//userspace/lib/fuchsia-component",
    ]
  }
  with_unit_tests = true
}

fuchsia_component("component") {
  component_name = "swdt"
  manifest = "meta/swdt.cml"
  deps = [ ":swdt" ]
}

fuchsia_package("package") {
  package_name = "swdt"
  deps = [ ":component" ]
}

group("tests") {
  testonly = true
  deps = [ ":swdt_test" ]
}
