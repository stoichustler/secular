import("//products/build/rust/rustc_library.gni")

rustc_library("cfg") {
  name = "secular_cfg"
  edition = "2024"
  sources = [ "src/lib.rs" ]
  with_unit_tests = true
  deps = [
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json5",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":cfg_test($host_toolchain)" ]
}
