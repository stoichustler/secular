# Packages added to the universe set complementing SDK images.
group("tools") {
  testonly = true
  public_deps = [ ":core-tools" ]
}

group("core-tools") {
  testonly = true
  public_deps = [
    "//userspace/developer/debug/debug_agent",
    "//userspace/graphics/lib/magma:magma-tools",
    "//userspace/media/audio/consumer/bundles:services",
    "//userspace/performance/trace",
    "//userspace/recovery/factory_reset:tools",
    "//userspace/sys/pkg/bin/far",
    "//userspace/ui/tools:scenic",
    "//third_party/curl:curl_pkg",
    "//third_party/openssh-portable:ssh-keygen-shell-pkg",
    "//third_party/openssh-portable:ssh-shell-pkg",
  ]
}

group("host_tools") {
  testonly = true
  public_deps = [
    "//userspace/performance/trace2json($host_toolchain)",
    "//userspace/sys/pkg/bin/far:host($host_toolchain)",
    "//tools/check-licenses($host_toolchain)",
    "//tools/fidl/fidlmerge($host_toolchain)",
    "//tools/fidl/gidl:host",
    "//tools/whereiscl($host_toolchain)",
  ]
}
