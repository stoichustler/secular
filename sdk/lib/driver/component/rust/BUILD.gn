import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

rustc_library("rust") {
  name = "fdf_component"
  version = "0.1.0"
  edition = "2024"
  with_unit_tests = true

  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]

  deps = [
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust",
    "//sdk/fidl/fuchsia.component.decl:fuchsia.component.decl_rust_next",
    "//sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust_next",
    "//sdk/fidl/fuchsia.device.fs:fuchsia.device.fs_rust",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust_next",
    "//sdk/fidl/fuchsia.logger:fuchsia.logger_rust",
    "//sdk/lib/async/rust/fidl",
    "//sdk/lib/driver/runtime/rust",
    "//sdk/lib/driver/runtime/rust/core",
    "//sdk/lib/driver/runtime/rust/env",
    "//sdk/lib/driver/runtime/rust/fdf_sys",
    "//sdk/lib/driver/runtime/rust/fidl",
    "//sdk/rust/zx",
    "//userspace/lib/diagnostics/inspect/contrib/rust",
    "//userspace/lib/diagnostics/inspect/runtime/rust",
    "//userspace/lib/diagnostics/inspect/rust",
    "//userspace/lib/diagnostics/log/rust:no_startup_handle",
    "//userspace/lib/fidl/rust/fidl",
    "//userspace/lib/fidl/rust_next/fidl_next",
    "//userspace/lib/fidl/rust_next/fidl_next_bind",
    "//userspace/lib/fidl/rust_next/fidl_next_protocol",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-component/config",
    "//userspace/lib/fuchsia-runtime",
    "//userspace/lib/fuchsia-sync",
    "//userspace/sys/lib/cm_types",
    "//userspace/sys/lib/namespace",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]

  test_deps = [
    "//examples/fidl/fuchsia.examples:fuchsia.examples_rust_next",
    "//sdk/fidl/fuchsia.hardware.i2c:fuchsia.hardware.i2c_rust",
    "//sdk/fidl/fuchsia.hwinfo:fuchsia.hwinfo_rust",
    "//userspace/lib/fuchsia",
    "//third_party/rust_crates:anyhow",
  ]

  sources = [
    "src/context.rs",
    "src/error.rs",
    "src/incoming.rs",
    "src/lib.rs",
    "src/macros.rs",
    "src/node.rs",
    "src/node/offers.rs",
    "src/node/properties.rs",
    "src/server.rs",
    "src/testing.rs",
    "src/testing/dut.rs",
    "src/testing/harness.rs",
    "src/testing/node.rs",
  ]
}

fuchsia_unittest_package("fdf_rust_component_tests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fdf_rust_component_tests" ]
}
