import("//products/build/components.gni")
import("//products/build/rust/rustc_library.gni")

rustc_library("rust") {
  name = "fake_pci"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust",
    "//sdk/fidl/fuchsia.hardware.pci:fuchsia.hardware.pci_rust_next",
    "//sdk/lib/driver/component/rust",
    "//sdk/rust/zx",
    "//userspace/lib/fidl/rust_next/fidl_next",
    "//userspace/lib/fuchsia-async",
    "//userspace/lib/fuchsia-component",
    "//userspace/lib/fuchsia-sync",
    "//third_party/rust_crates:arrayvec",
  ]

  test_deps = [
    "//sdk/lib/driver/fake-bti/rust",
    "//userspace/lib/fuchsia",
    "//userspace/lib/testing/fixture",
  ]

  sources = [ "src/lib.rs" ]
  configs += [ "//products/build/config/rust/lints:clippy_warn_all" ]
}

fuchsia_unittest_package("fake-pci-rust-unittests") {
  deps = [ ":rust_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":fake-pci-rust-unittests" ]
}
