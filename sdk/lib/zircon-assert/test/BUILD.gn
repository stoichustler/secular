import("//products/build/components/fuchsia_unittest_package.gni")
import("//products/build/test.gni")
import("//products/build/testing/bootfs_test.gni")

group("test") {
  testonly = true
  deps = [ ":tests" ]
}

group("tests") {
  testonly = true
  deps = [
    ":zircon-assert-tests",
    ":zircon-assert-unittests($host_toolchain)",
  ]
}

test("zircon-assert-unittests") {
  sources = [ "zircon-assert-tests.cc" ]
  deps = [
    "..",
    "//userspace/lib/fxl/test:gtest_main",
    "//userspace/sys/test_runners/gtest:death_test",
    "//third_party/googletest:gmock",
  ]
}

fuchsia_unittest_package("zircon-assert-tests") {
  deps = [ ":zircon-assert-unittests" ]
}

bootfs_test("zircon-assert-bootfs-test") {
  name = "zircon-assert-unittests"
  deps = [ ":zircon-assert-unittests" ]
}
