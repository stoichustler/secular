# Visibility allowlists for restricted third-party Rust crates in GN.
#
# //third_party/rust_crates/BUILD.bazel has the corresponding Bazel allowlists
# as package_groups, which only list packages with Bazel targets that use each
# crate. When migrating a target to Bazel, add its package there, and remove it
# from here once no GN targets in the package use the crate.

md5_visibility = [
  #  ________  _________  ________  ________
  # |\   ____\|\___   ___\\   __  \|\   __  \
  # \ \  \___|\|___ \  \_\ \  \|\  \ \  \|\  \
  #  \ \_____  \   \ \  \ \ \  \\\  \ \   ____\
  #   \|____|\  \   \ \  \ \ \  \\\  \ \  \___|
  #     ____\_\  \   \ \__\ \ \_______\ \__\
  #    |\_________\   \|__|  \|_______|\|__|
  #    \|_________|
  #
  # This is an allowlist of targets that use the `md-5` Rust library, which
  # implements the insecure and deprecated MD-5 hash function. Code should only
  # use this if it's implementing legacy protocols that require MD-5; it should
  # never be used for new cryptographic development.

  "//userspace/connectivity/wlan/lib/rsn:*",
]

