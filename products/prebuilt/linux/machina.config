# Secular Machina ARM64 Linux guest fragment.
# Applied on top of arm64 defconfig + virt.config.
# Serial/virtio-console guest only: drop net, USB, Bluetooth, GPU, sound.

CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_ELF=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARM_PSCI_FW=y
CONFIG_RTC_DRV_PL031=y

# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_MODULES is not set

# Unused subsystems (seen in the previous 46 MiB Image boot log).
