import("//products/build/config/zircon/standard.gni")
import("//products/build/toolchain/zircon/zircon_toolchain_suite.gni")

if (current_toolchain == default_toolchain) {
  foreach(cpu, standard_fuchsia_cpus) {
    zircon_toolchain_suite("user.basic_$cpu") {
      cpu = cpu
      os = "fuchsia"
      strip = "--strip-sections"
      environment = "user.basic"

      configs = [
        "//products/build/config/zircon:user",
        "//products/build/config/zircon:user-link",
        "//products/build/config:no-compiler-abi",
      ]
      source_deps = [ "//products/build/config/zircon:user_deps" ]

      executable_configs = [ "//products/build/config/zircon:user-executable" ]

      tags = [
        "no-compiler-abi",
        "no-floating-point",
        "standalone",
      ]
      exclude_variant_tags = [ "needs-compiler-abi" ]
    }
  }
}
