assert(is_host, "This tool is only applicable on the host toolchain")

import("//products/build/bazel/bazel_inputs.gni")
import("//products/build/rust/rustc_binary.gni")
import("//products/build/sdk/sdk_host_tool.gni")

rustc_binary("assembly_config") {
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/board_config.rs",
    "src/board_input_bundle.rs",
    "src/board_input_bundle_set.rs",
    "src/main.rs",
    "src/partitions_config.rs",
    "src/platform_artifacts.rs",
    "src/product_config.rs",
    "src/product_input_bundle.rs",
  ]
  output_name = "assembly_config"
  deps = [
    "//userspace/lib/assembly/config_schema",
    "//userspace/lib/assembly/container",
    "//userspace/lib/assembly/partitions_config",
    "//userspace/lib/assembly/platform_artifacts",
    "//userspace/lib/assembly/product_input_bundle",
    "//userspace/lib/assembly/release_info",
    "//userspace/lib/assembly/util",
    "//userspace/lib/depfile",
    "//userspace/starnix/lib/starnix_container",
    "//userspace/sys/pkg/lib/far/rust:fuchsia-archive",
    "//userspace/sys/pkg/lib/fuchsia-pkg",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:camino",
    "//third_party/rust_crates:serde",
    "//third_party/rust_crates:serde_json",
    "//third_party/rust_crates:tempfile",
  ]
  test_deps = [
    "//userspace/lib/fuchsia-url",
    "//userspace/lib/versioning/version-history/rust",
    "//third_party/rust_crates:itertools",
    "//third_party/rust_crates:serde_json",
  ]
}

sdk_host_tool("assembly_config_sdk") {
  category = "partner"
  output_name = "assembly_config"
  deps = [ ":assembly_config" ]
}

bazel_input_file("bazel_input") {
  generator = ":assembly_config"
  outputs = [ "${root_out_dir}/assembly_config" ]
}
