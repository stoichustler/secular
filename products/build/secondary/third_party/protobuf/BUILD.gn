      "src/src/google/protobuf/compiler/rust/message.cc",
      "src/src/google/protobuf/compiler/rust/naming.cc",
      "src/src/google/protobuf/compiler/rust/oneof.cc",
      "src/src/google/protobuf/compiler/rust/relative_path.cc",
      "src/src/google/protobuf/compiler/rust/rust_field_type.cc",
      "src/src/google/protobuf/compiler/rust/rust_keywords.cc",
      "src/src/google/protobuf/compiler/rust/upb_helpers.cc",
      "src/src/google/protobuf/compiler/subprocess.cc",
      "src/src/google/protobuf/compiler/versions.cc",
      "src/src/google/protobuf/compiler/zip_writer.cc",
      "src/src/google/protobuf/testing/file.cc",
    ]
    include_dirs = [ "//third_party/protobuf/src" ]
    configs += [ ":protobuf_warnings" ]
    public_deps = [
      ":protobuf_full",
      ":upb",
    ]
  }

  executable("protoc") {
    visibility += visibility_protoc
    sources = [ "src/src/google/protobuf/compiler/main.cc" ]
    deps = [ ":protoc_lib" ]
  }
} else {
  group("protoc") {
    visibility += visibility_protoc
    deps = [ ":protoc($host_toolchain)" ]
  }
}
