# These tools are normally provided by Pigweed bootstrap.
#   See: https://pigweed.dev/pw_env_setup/
# For Fuchsia they live under prebuilt/third_party/*
default_args = {
  pw_toolchain_CLANG_PREFIX =
      rebase_path("${secular_prebuilt_root}/third_party/clang/${secular_host_platform}/bin",
                  root_build_dir)
  pw_toolchain_RUST_PREFIX =
      rebase_path("${rustc_prefix}/bin",
                  root_build_dir)
}

declare_args() {
  pw_env_setup_CIPD_DEFAULT = "${secular_prebuilt_root}/third_party"
  pw_env_setup_CIPD_PIGWEED = "${secular_prebuilt_root}/third_party"
  pw_env_setup_CIPD_PYTHON =
      rebase_path("${secular_prebuilt_root}/third_party/python/${host_os}-${host_cpu}/bin",
                  root_build_dir)
  pw_env_setup_CIPD_BAZEL =
      rebase_path("${secular_prebuilt_root}/third_party/bazel/${host_os}-${host_cpu}/bin",
                  root_build_dir)
}
