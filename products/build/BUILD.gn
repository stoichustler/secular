    "//userspace/graphics/drivers/arm-mali/icd:libvulkan_arm_g52_r0p0",
    "//userspace/graphics/drivers/arm-mali/icd:libvulkan_arm_g52_r0p0.package",
    "//userspace/ui/backlight/drivers:chromebook-keyboard-backlight",
    "//userspace/ui/backlight/drivers:chromebook-keyboard-backlight.package",
  ]

  # TODO(https://fxbug.dev/454618550): Remove this
  visibility += [ "//products/build/prebuilt" ]

  # TODO(https://fxbug.dev/42165766): License analysis uses the output of 'fx gn gen', which
  # can potentially touch every file in the repository. Remove this entry when
  # license management becomes a hermetic process.
  visibility += [ "//tools/check-licenses/build/*" ]

  visibility += [
    "//userspace/secular/bin/userboot/tests:*",
    "//userspace/tests/early-boot-coverage/*",
  ]

  # TODO(https://fxbug.dev/331492588): Template driver example wraps Bazel output in Ninja, and
  # depends on non_hermetic_deps.
  visibility += [
    "//examples/drivers:*",
    "//examples/drivers/simple/dfv2:*",
    "//examples/drivers/template:*",
    "//examples/drivers/transport/driver/v2:*",
  ]

  # product config for boot_tests.
  visibility += [ "//products/build/testing/boot_tests:product_config" ]

  # Boot tests defined here use a custom QEMU kernel taken from under
  # ${secular_prebuilt_root}s. The definition of an emulator AIB in this case can result in
  # non-deterministic outputs for the reason indicated around the setting of
  # hermetic_action_ignored_prefixes in
  # emulator_support_assembly_input_bundle()
  visibility += [ "//userspace/microfuchsia:*" ]

  # Starnix VM-backed tests, which use //boards.
  visibility += [
    "//products/bundles/buildbot/virtualization:starnix_linux_vm_bundle.assembled_system.image_assembler",
    "//products/bundles/buildbot/virtualization:starnix_linux_vm_bundle.assembled_system.product_assembler",
    "//products/bundles/buildbot/virtualization:starnix_linux_vm_bundle.product_configuration",
    "//products/bundles/buildbot/virtualization:starnix_linux_vm_bundle_product_bundle",
    "//products/bundles/buildbot/virtualization:starnix_linux_vm_bundle_transfer_manifest",
  ]

  # Metadata that is generated by gn desc must not be subject to hermeticity
  # rules.
  visibility += [ "//products/build:target_metadata" ]

  # Exporting @rules_fuchsia for OOT usage creates a directory with
  # unpredictable content.
  visibility += [ "//:rules_fuchsia.export" ]

  # distribution_manifest_copy() uses.
  visibility += [
    "//sdk/lib/ld/test/modules/*",
    "//zircon/kernel/lib/rust/*",
  ]
}

# Build targets that use the legacy zx_library and zx_host_tool templates
# need to depend on the target below and appear in the visibility list.
# Please don't introduce new uses of these wrappers. Rather:
#
# Instead of zx_library, please use one of the following templates:
# - source_set
# - sdk_source_set
# - static_library
# - sdk_static_library
# - shared_library
