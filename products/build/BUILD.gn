      "bazel/examples/hello_python/bin.py",
      "bazel/examples/hello_python/lib.py",
      "bazel/examples/hello_python/test.py",
      "bazel/fuchsia_idk/generate_repository_validation.py",
      "bazel/rules/host_tests/tests/py/lib_for_test.py",
      "bazel/rules/host_tests/tests/py/list_unittests_test.py",
      "bazel/rules/host_tests/tests/py/simple_test.py",
      "bazel/rules/host_tests/tests/py/test_with_py_binary.py",
      "bazel/rules/host_tests/tests/py/test_with_py_library.py",
      "bazel/rules/host_tests/tests/py/test_with_unittests.py",
      "beads/.agent/skills/analyzing_migration_dag/scripts/analyze_migration_dag.py",
      "check_product_bundles_manifest.py",
      "config/clang/generate_config_json.py",
      "config/fuchsia/get_platform_version.py",
      "copy_tree.py",
      "cpp/binaries.py",
      "cpp/verify_pragma_once.py",
      "cpp/verify_public_headers.py",
      "dart/gen_app_invocation.py",
      "dart/gen_dart_test_invocation.py",
      "dart/group_tests.py",
      "dart/merge_deps_sources.py",
      "dart/verify_sources.py",
      "depfile_path_to_relative.py",
      "dist/convert_fini_to_manifest.py",
      "dist/convert_manifest_to_fini.py",
      "dist/distribution-manifest-copy.py",
      "drivers/assert_driver_components.py",
      "drivers/check_included_drivers.py",
      "drivers/create_driver_doc.py",
      "drivers/create_driver_manifest.py",
      "fidl/gen_ir_root_out.py",
      "fidl/gen_response_file.py",
      "force_clean/force_clean_if_needed.py",
