if (is_host) {
  python_build_time_tests("regenerator_tests") {
    tests = [ "//products/build/regenerator_test.py" ]
    inputs = [
               "//products/build/bazel/fuchsia_idk/generate_repository.py",
               "//products/build/bazel/scripts/compute_content_hash.py",
               "//products/build/bazel/scripts/get_git_head_commit.py",
               "//products/build/regenerator.py",
             ] + libc_headers.idk_generate_inputs
    deps = [
      "//products/build/rbe:rbe_settings",
      "//products/build/scripts:properties_lib",
    ]
  }

  python_build_time_tests("build_tests_json_tests") {
    tests = [ "//products/build/build_tests_json_test.py" ]
    inputs = [
      "//products/build/build_tests_json.py",
      "//products/build/bazel/scripts/build_utils.py",
      "//products/build/bazel/scripts/bazel_tests_utils.py",
    ]
    deps = [ "//products/build/python/modules/serialization" ]
  }

  # Python scripts under //build that aren't part of any other Python target,
  # usually because they're run directly by action() or Bazel rules. Listing
  # them here makes them subject to type checking. Directories with many
  # such scripts (//products/build/bazel/scripts, //products/build/bazel_sdk and //products/build/rbe)
  # have their own type_checked_scripts targets instead.
  #
  # Cross-directory modules that a script imports via sys.path manipulation
  # must be in library_deps. Otherwise mypy either treats them as Any due to
  # `ignore_missing_imports` in //pyproject.toml or, worse, resolves them to
  # a same-named directory in the build directory, since mypy always searches
  # its working directory. The latter makes type checking depend on the
  # build configuration.
  python_library("type_checked_scripts") {
    testonly = true

    # This target only exists for type checking; depending on it would package
    # a grab-bag of unrelated scripts.
    visibility = [ ":*" ]
    library_deps = [
      # For packages/generate_package_debug_symbols_manifest.py.
      "//products/build/api:debug_symbols",
    ]
    source_root = "//products/build"
    sources = [
      "assembly/scripts/bootfs_distribution_manifest.py",
      "bazel/assembly/size_checker/verify_verbose_size_report.py",
      "bazel/bazel_idk/prebuild_info.py",
      "bazel/bazel_sdk/compare_bazel_sdks.py",
      "bazel/bazel_sdk/idk_to_bazel_sdk.py",
      "bazel/config/toolchain_tags/update.py",
