import("//products/build/bazel/assembly/bazel_product_image.gni")

# Guest product image built via Bazel and bridged to Ninja
bazel_product_image("guest") {
  testonly = true
  bazel_product_image_target = "//products/build/images/guest:guest_product"
  bazel_inputs_from_gn = [
    "//userspace/devices/board/drivers/qemu-arm64:package.bazel_input",
    "//userspace/devices/block/drivers/ahci:package.bazel_input",
    "//userspace/devices/board/drivers/x86:package.bazel_input",
    "//userspace/devices/i2c/drivers/intel-i2c:package.bazel_input",
    "//userspace/devices/serial/drivers/uart16550:package.bazel_input",
    "//userspace/hypervisor/tests:virtualization_test_utils_pkg_bazel",
    "//userspace/performance/trace:trace_bazel",
    "//products/boards/emulation/virtio:virtio.bazel_inputs",
  ]
  image_use_vbmeta = false
  image_has_fxfs_blob = true
}
