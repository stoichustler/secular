import("//products/build/assembly/bootfs_files_for_assembly.gni")
import("//products/build/dist/resource.gni")
import("//products/build/info/info.gni")

bootfs_files_for_assembly("bootfs") {
  deps = [ ":minimum_utc_stamp" ]
}

resource("minimum_utc_stamp") {
  sources = [ build_info_files.minimum_utc_stamp ]
  outputs = [ "config/build_info/minimum_utc_stamp" ]
  deps = [ "//products/build/info:latest-commit-date-and-hash" ]
  visibility = [
    ":*",
    "//products/secular:*",
  ]
}
