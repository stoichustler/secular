assert(current_toolchain == default_toolchain,
       "Boards are only defined in the default toolchain")

group("boards") {
  testonly = true
  deps = [ ":$target_cpu" ]
}

if (target_cpu == "arm64") {
  group("arm64") {
    testonly = true
    deps = [
      "//products/boards/arm64",
      "//products/boards/qemu-arm64",
    ]
  }
}
