// cmc --must-offer-dictionary diagnostics requires bootstrap to offer
// diagnostics to every child. Assembly normally injects these.
{
    offer: [
        {
            dictionary: "diagnostics",
            from: "self",
            to: "#archivist",
            dependency: "weak",
        },
        {
            dictionary: "diagnostics",
            from: "self",
            to: [
                "#boot-drivers",
                "#devfs-with-pkg",
            ],
        },
        {
            directory: "config",
            from: "void",
            to: "#archivist",
            availability: "optional",
        },
    ],
}
