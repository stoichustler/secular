// Satisfy bootstrap.cml's expose of #boot-drivers and its offer from
// #devfs-with-pkg without the full driver-framework graph.
{
    children: [
        {
            name: "devfs-with-pkg",
            url: "fuchsia-boot:///devfs#meta/devfs-pkg.cm",
        },
    ],
    collections: [
        {
            name: "boot-drivers",
            durability: "transient",
        },
    ],
}
